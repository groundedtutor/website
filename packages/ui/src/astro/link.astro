---
interface Props {
  href: string;
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted";
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  lg: "px-5 py-2.5 text-base",
  md: "px-4 py-2 text-sm",
};

const styles = {
  outline:
    "bg-transparent border-2 border-surface-900 text-surface-900 hover:bg-surface-900 hover:text-surface-50",
  primary:
    "bg-surface-900 text-surface-50 hover:bg-surface-700 border-2 border-transparent",
  inverted: "bg-surface-50 text-surface-900 border-2 border-transparent hover:bg-surface-100",
  muted: "bg-surface-100 text-surface-800 hover:bg-surface-200 border-2 border-transparent",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded font-semibold transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-current focus-visible:outline-none",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</a>
