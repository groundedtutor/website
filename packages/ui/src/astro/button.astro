---
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  md: "px-5 py-2.5 text-sm",
  lg: "px-6 py-3 text-base",
};

const styles = {
  outline:
    "border-2 border-current text-current hover:bg-current hover:text-white",
  primary:
    "bg-surface-900 text-surface-50 hover:bg-surface-700 border-2 border-transparent",
  inverted: "bg-surface-50 text-surface-900 border-2 border-transparent hover:bg-surface-100",
};
---

<button
  {...rest}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded font-semibold transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-current focus-visible:outline-none",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</button>
