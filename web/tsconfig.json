{
   "extends": "astro/tsconfigs/strict",
   "compilerOptions": {
      "strictNullChecks": true,
      "verbatimModuleSyntax": true,
      "ignoreDeprecations": "5.0",
      "lib": ["dom"],
      "paths": {
         "@lib/*": ["./src/lib/*"],
         "@utils/*": ["./src/utils/*"],
         "@layouts/*": ["./src/layouts/*"],
         "@assets/*": ["./src/assets/*"],
         "@pages/*": ["./src/pages/*"],
         "@store/*": ["./src/store/*"]
      },
      "jsx": "react-jsx",
      "jsxImportSource": "react",
      "plugins": [
         {
            "name": "@astrojs/ts-plugin"
         }
      ]
   },
   "references": [
      {
         "path": "./tsconfig.node.json"
      }
   ],
   "exclude": ["astro.config.ts"]
}
