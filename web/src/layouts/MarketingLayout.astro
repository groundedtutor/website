---
import { PhoneIcon, MailIcon, CalendarCheckIcon } from "@lucide/astro";
import { SEOMetadata } from "astro-seo-metadata";
import Header from "@components/Header.astro";
import ScrollToTop from "@components/ScrollToTop.astro";
import {
    PUBLIC_BOOKING_EMAIL,
    PUBLIC_SITE_NAME,
    PUBLIC_SITE_PHONE,
    PUBLIC_SITE_PHONE_FORMATTED,
} from "astro:env/client";
import { themeStorageKey } from "@utils/theme-mode";

import "../styles/global.css";

export interface Props {
    title: string;
    description?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedImageWithDomain = new URL("/opengraph.jpg", Astro.site).toString();
const {
    title: pageTitle,
    description = "Patient, plain-English tech support for older adults in Montreal. In-home visits, phone support, and online help for computers, phones, tablets, and more.",
} = Astro.props;
const fullTitle = `${pageTitle} | ${PUBLIC_SITE_NAME}`;
---

<!doctype html>
<html lang="en" data-theme="grounded">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <SEOMetadata
            siteName={PUBLIC_SITE_NAME}
            title={fullTitle}
            description={description}
            image={resolvedImageWithDomain}
            favicon="/favicon.svg"
            author={PUBLIC_SITE_NAME}
            astroSitemap={true}
            canonicalUrl={canonicalURL}
            type="website"
            astroGenerator={true}
        />
        <script is:inline define:vars={{ themeStorageKey }}>
            (() => {
                let mode = "auto";

                try {
                    mode = localStorage.getItem(themeStorageKey)?.toLowerCase();
                } catch {}

                if (!["light", "dark"].includes(mode)) {
                    mode = "auto";
                }
                document.documentElement.setAttribute("data-theme-mode", mode);

                try {
                    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
                    if (mode === "dark" || (mode === "auto" && prefersDark.matches)) {
                        document.documentElement.classList.add("dark");
                    }
                } catch {}
            })();
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    </head>
    <body>
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:px-4 focus:py-2"
        >
            Skip to main content
        </a>
        <!-- ─────────────────────────────────────────────
            HEADER
        ───────────────────────────────────────────── -->
        <slot name="header">
            <Header bookingUrl="/#contact" />
        </slot>
        <!-- ─────────────────────────────────────────────
            MAIN CONTENT
        ───────────────────────────────────────────── -->
        <main id="main-content">
            <slot />
        </main>
        <ScrollToTop />
        <!-- ─────────────────────────────────────────────
            FOOTER
        ───────────────────────────────────────────── -->
        <slot name="footer">
            <footer class="bg-surface-950-50 text-surface-300-700">
                <div class="mx-auto max-w-6xl px-5 py-14 md:px-8">
                    <div class="mb-10 grid gap-10 md:grid-cols-4">
                        <!-- Brand -->
                        <div>
                            <span class="text-lg font-bold text-white">
                                <span class="text-primary-300">Grounded</span>Tutor
                            </span>
                            <p class="mt-3 text-sm leading-relaxed text-surface-400-600">
                                Friendly, patient tech help for older adults in Montreal. In-home, by
                                phone, or online.
                            </p>
                        </div>

                        <!-- Quick links -->
                        <div>
                            <p
                                class="mb-4 text-xs font-bold tracking-widest text-primary-500 uppercase"
                            >
                                Services
                            </p>
                            <ul class="space-y-2 text-sm">
                                <li>
                                    <a href="#tech-help" class="transition-colors hover:text-white"
                                        >Friendly Tech Help Session</a
                                    >
                                </li>
                                <li>
                                    <a href="#device-setup" class="transition-colors hover:text-white"
                                        >New Device Setup</a
                                    >
                                </li>
                                <li>
                                    <a href="#safety" class="transition-colors hover:text-white"
                                        >Online Safety &amp; Scam Protection</a
                                    >
                                </li>
                                <li>
                                    <a href="#backup" class="transition-colors hover:text-white"
                                        >Photo, File &amp; Backup Organization</a
                                    >
                                </li>
                                <li>
                                    <a href="#plans" class="transition-colors hover:text-white"
                                        >Ongoing Support Plans</a
                                    >
                                </li>
                            </ul>
                        </div>

                        <!-- Policies -->
                        <div>
                            <p
                                class="mb-4 text-xs font-bold tracking-widest text-primary-500 uppercase"
                            >
                                Policies
                            </p>
                            <ul class="space-y-2 text-sm">
                                <li>
                                    <a href="/privacy" class="transition-colors hover:text-white"
                                        >Privacy Policy</a
                                    >
                                </li>
                                <li>
                                    <a
                                        href="/password-policy"
                                        class="transition-colors hover:text-white"
                                        >Sensitive Access &amp; Password Policy</a
                                    >
                                </li>
                            </ul>
                        </div>

                        <!-- Contact -->
                        <div>
                            <p
                                class="mb-4 text-xs font-bold tracking-widest text-primary-500 uppercase"
                            >
                                Contact
                            </p>
                            <ul class="space-y-2 text-sm">
                                <li>
                                    <a
                                        href={`tel:${PUBLIC_SITE_PHONE}`}
                                        class="flex items-center gap-2 transition-colors hover:text-white"
                                    >
                                        <PhoneIcon class="size-3.5" />{PUBLIC_SITE_PHONE_FORMATTED}
                                    </a>
                                </li>
                                <li>
                                    <a
                                        href={`mailto:${PUBLIC_BOOKING_EMAIL}`}
                                        class="flex items-center gap-2 transition-colors hover:text-white"
                                    >
                                        <MailIcon class="size-3.5" />{PUBLIC_BOOKING_EMAIL}
                                    </a>
                                </li>
                                <li class="pt-1">
                                    <a
                                        href="#/contact"
                                        class="inline-flex items-center gap-1.5 rounded-lg bg-primary-500 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-primary-600"
                                    >
                                        <CalendarCheckIcon class="size-3.5" />Book a Session
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Disclaimers -->
                    <div
                        class="text-surface-500-400 space-y-2 border-t border-surface-800 pt-8 text-xs leading-relaxed"
                    >
                        <p>
                            <strong class="text-primary-500">Disclaimer:</strong> GroundedTutor does not
                            provide financial, legal, medical, or investment advice. Scam protection and
                            security reviews reduce risk but cannot guarantee complete protection from scams,
                            fraud, or malware. Backup and file transfer services cannot guarantee that every
                            file can be recovered or preserved. Customers must provide access to accounts,
                            passwords, unlock codes, and third-party subscriptions where needed. Results
                            depend on device condition, account access, storage availability, and third-party
                            services.
                        </p>
                        <p>
                            Personal information collected for booking or service records is handled
                            in accordance with applicable Canadian and Quebec privacy requirements.
                        </p>
                    </div>

                    <div
                        class="text-surface-500-400 mt-8 border-t border-surface-800 pt-6 text-center text-xs"
                    >
                        Copyright &copy; {new Date().getFullYear()}
                        {import.meta.env.PUBLIC_SITE_NAME}. All rights reserved.
                    </div>
                </div>
            </footer>
        </slot>
    </body>
</html>
