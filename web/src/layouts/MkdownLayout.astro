---
import { PUBLIC_SITE_NAME } from "astro:env/client";
import MarketingLayout from "./MarketingLayout.astro";

export interface Props {
    frontmatter: { title: string; description: string };
}

const {
    frontmatter: { title: pageTitle },
} = Astro.props;
const fullTitle = `${pageTitle} | ${PUBLIC_SITE_NAME}`;
---

<MarketingLayout title={fullTitle}>
    <main
        class="mx-auto prose max-w-3xl px-5 pb-20 pt-4 md:prose-lg md:px-8 prose-policy dark:prose-invert"
    >
        <div class="h-16"></div>
        <slot />
    </main>
</MarketingLayout>
