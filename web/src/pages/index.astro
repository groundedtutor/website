---
import MarketingLayout from "@layouts/MarketingLayout.astro";
import {
    LaptopIcon,
    SmartphoneIcon,
    ShieldCheckIcon,
    FolderOpenIcon,
    HeartHandshakeIcon,
    MapPinIcon,
    CheckCircle2Icon,
    PhoneIcon,
    HomeIcon,
    WifiIcon,
    StarIcon,
    MailIcon,
    CalendarCheckIcon,
    ChevronRightIcon,
    LockIcon,
    UserCheckIcon,
    PrinterIcon,
    HelpCircleIcon,
    RefreshCwIcon,
    MonitorIcon,
    VideoIcon,
    ArrowRightIcon,
} from "@lucide/astro";

const bookingUrl = import.meta.env.PUBLIC_BOOK_PAIR_PROGRAMMING || "#contact";

const services = [
    {
        id: "tech-help",
        icon: LaptopIcon,
        accentClass: "bg-brown-700",
        title: "Friendly Tech Help Session",
        remote: "$79",
        inHome: "$119",
        description:
            "Get help with a specific tech problem, an everyday question, or just build your confidence with technology — at your own pace.",
        examples: [
            "Slow computer, phone, or tablet",
            "Email problems",
            "Printer & Wi-Fi issues",
            "Video calls with family, doctors, or appointments",
            "Help using an app or website",
            "General technology questions",
        ],
        goodFor: "First-time support, troubleshooting, building confidence",
        note: null,
    },
    {
        id: "device-setup",
        icon: SmartphoneIcon,
        accentClass: "bg-brown-500",
        title: "New Device Setup",
        remote: "$99",
        inHome: "$149",
        description:
            "Just got a new phone, tablet, computer, or smart device? We'll set it up properly so it works the way you need it to.",
        examples: [
            "Basic setup, updates, and account sign-in",
            "Email, contacts, and apps",
            "Transferring contacts, photos, or files where possible",
            "Printer, Wi-Fi, and Bluetooth setup",
            "Larger text, voice controls & accessibility settings",
            "Smart home setup: doorbells, cameras, thermostats",
        ],
        goodFor: "New phones, tablets, computers, printers, smart TVs, and streaming devices",
        note: "You'll need to provide account passwords, unlock codes, and pay any third-party subscription costs.",
    },
    {
        id: "safety",
        icon: ShieldCheckIcon,
        accentClass: "bg-brown-400",
        title: "Online Safety & Scam Protection Review",
        remote: "$119",
        inHome: "$159",
        description:
            "Feel more confident online. We help you recognize scams, secure your accounts, and protect what matters most to you.",
        examples: [
            "Password and account safety review",
            "Help setting up a password manager",
            "Two-factor authentication setup",
            "Recognizing scam emails, calls & fake websites",
            "Social media privacy settings",
            "Safer online shopping and banking habits",
        ],
        goodFor: "Anyone worried about scams, suspicious emails, or online security",
        note: "This service helps reduce risk but cannot guarantee complete protection from all scams, fraud, or malware.",
    },
    {
        id: "backup",
        icon: FolderOpenIcon,
        accentClass: "bg-caramel-400",
        title: "Photo, File & Backup Organization",
        remote: "$119",
        inHome: "$159",
        description:
            "Protect your memories and important documents. We'll organize your files and set up backups so you don't lose what matters.",
        examples: [
            "Reviewing and setting up cloud or external-drive backups",
            "Organizing photos, videos, and documents",
            "Email cleanup and file-saving guidance",
            "Scanning old photos where equipment and time allow",
            "Creating simple folders and albums easy to find",
        ],
        goodFor: "Anyone whose photos and files are scattered or unprotected",
        note: "Backup services reduce the chance of data loss but cannot guarantee every file can be recovered, transferred, or preserved.",
    },
];

const bookingSteps = [
    {
        number: "1",
        icon: PhoneIcon,
        title: "Tell Us What You Need",
        desc: "Call, email, or fill out our contact form. Describe your problem in plain language — no technical terms needed.",
    },
    {
        number: "2",
        icon: HeartHandshakeIcon,
        title: "We Recommend the Best Option",
        desc: "We'll suggest the right service and advise whether remote or in-home support makes more sense for your situation.",
    },
    {
        number: "3",
        icon: CalendarCheckIcon,
        title: "Choose a Time That Works",
        desc: "Pick an appointment time that's convenient for you. We'll work around your schedule.",
    },
    {
        number: "4",
        icon: UserCheckIcon,
        title: "We Explain Everything First",
        desc: "Before making any changes, we explain what we're going to do and ask for your approval. You stay in control.",
    },
    {
        number: "5",
        icon: CheckCircle2Icon,
        title: "Simple Next Steps After",
        desc: "After your session you'll receive clear, plain-language next steps you can keep and refer back to.",
    },
];

const revealDelays = [
    "reveal-delay-1",
    "reveal-delay-2",
    "reveal-delay-3",
    "reveal-delay-4",
    "reveal-delay-5",
];

const decisionItems = [
    { quote: "My computer is slow.", service: "Friendly Tech Help Session", anchor: "#tech-help" },
    {
        quote: "I bought a new phone, tablet, or computer.",
        service: "New Device Setup",
        anchor: "#device-setup",
    },
    {
        quote: "I'm worried about scams or passwords.",
        service: "Online Safety & Scam Protection Review",
        anchor: "#safety",
    },
    {
        quote: "My photos and files are everywhere.",
        service: "Photo, File & Backup Organization",
        anchor: "#backup",
    },
    { quote: "I want ongoing help.", service: "Ongoing Support Plan", anchor: "#plans" },
];
---

<MarketingLayout
    title="Friendly Tech Help for Older Adults in Montreal"
    description="Patient, plain-English tech support for older adults in Montreal. In-home visits, phone support, and online help for computers, phones, tablets, and more."
>
    <!-- Skip nav for accessibility -->
    <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-brown-700 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg"
    >
        Skip to main content
    </a>

    <!-- ─────────────────────────────────────────────
         NAVIGATION
    ───────────────────────────────────────────── -->
    <header id="site-nav" class="fixed top-0 left-0 right-0 z-40">
        <div class="max-w-7xl mx-auto px-5 md:px-8">
            <nav
                class="flex items-center justify-between h-16 md:h-20"
                aria-label="Main navigation"
            >
                <!-- Logo -->
                <a href="/" class="flex-shrink-0" aria-label="GroundedTutor — Home">
                    <span class="text-lg md:text-xl font-bold tracking-tight">
                        <span class="text-brown-700">Grounded</span><span class="text-brown-950"
                            >Tutor</span
                        >
                    </span>
                </a>

                <!-- Desktop links -->
                <ul
                    class="hidden md:flex items-center gap-7 text-sm font-medium text-brown-700"
                    role="list"
                >
                    <li>
                        <a href="#services" class="hover:text-brown-950 transition-colors"
                            >Services</a
                        >
                    </li>
                    <li>
                        <a href="#plans" class="hover:text-brown-950 transition-colors">Plans</a>
                    </li>
                    <li>
                        <a href="#how-it-works" class="hover:text-brown-950 transition-colors"
                            >How It Works</a
                        >
                    </li>
                    <li>
                        <a href="#contact" class="hover:text-brown-950 transition-colors"
                            >Contact</a
                        >
                    </li>
                </ul>

                <!-- Desktop CTA -->
                <a
                    href={bookingUrl}
                    class="hidden md:inline-flex items-center gap-2 bg-brown-700 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-brown-800 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brown-700 focus-visible:ring-offset-2"
                >
                    <CalendarCheckIcon class="size-4" />
                    Book a Session
                </a>

                <!-- Mobile menu toggle -->
                <button
                    id="mobile-menu-btn"
                    class="md:hidden p-2 text-brown-700 hover:text-brown-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brown-700 focus-visible:ring-offset-2 rounded"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                    aria-label="Open navigation menu"
                >
                    <span class="block w-6 h-0.5 bg-current mb-1.5 transition-all" id="mbar1"
                    ></span>
                    <span class="block w-6 h-0.5 bg-current mb-1.5 transition-all" id="mbar2"
                    ></span>
                    <span class="block w-6 h-0.5 bg-current transition-all" id="mbar3"></span>
                </button>
            </nav>
        </div>

        <!-- Mobile menu panel -->
        <div
            id="mobile-menu"
            class="hidden md:hidden bg-brown-50 border-t border-brown-200 shadow-lg"
            role="dialog"
            aria-label="Mobile navigation"
        >
            <div class="max-w-7xl mx-auto px-5 py-5 space-y-1">
                <a
                    href="#services"
                    class="block py-3 px-4 text-brown-800 font-medium hover:bg-brown-100 rounded-lg transition-colors"
                    >Services</a
                >
                <a
                    href="#plans"
                    class="block py-3 px-4 text-brown-800 font-medium hover:bg-brown-100 rounded-lg transition-colors"
                    >Plans</a
                >
                <a
                    href="#how-it-works"
                    class="block py-3 px-4 text-brown-800 font-medium hover:bg-brown-100 rounded-lg transition-colors"
                    >How It Works</a
                >
                <a
                    href="#contact"
                    class="block py-3 px-4 text-brown-800 font-medium hover:bg-brown-100 rounded-lg transition-colors"
                    >Contact</a
                >
                <div class="pt-3 pb-1">
                    <a
                        href={bookingUrl}
                        class="block w-full text-center bg-brown-700 text-white px-5 py-3.5 rounded-xl font-semibold hover:bg-brown-800 transition-colors"
                        >Book a Session</a
                    >
                </div>
            </div>
        </div>
    </header>

    <main id="main-content">
        <!-- ─────────────────────────────────────────────
             HERO
        ───────────────────────────────────────────── -->
        <section
            class="relative min-h-screen flex items-center bg-brown-950 overflow-hidden pt-16 md:pt-20"
        >
            <!-- Ambient glows -->
            <div
                class="absolute top-1/3 left-1/4 w-[28rem] h-[28rem] rounded-full bg-brown-700 opacity-20 blur-3xl pointer-events-none"
            >
            </div>
            <div
                class="absolute bottom-1/4 right-1/5 w-64 h-64 rounded-full bg-caramel-400 opacity-10 blur-3xl pointer-events-none"
            >
            </div>

            <!-- Decorative rings -->
            <div
                class="absolute top-24 right-8 md:right-20 w-56 h-56 rounded-full border border-brown-700 opacity-25 pointer-events-none"
            >
            </div>
            <div
                class="absolute top-40 right-20 md:right-36 w-32 h-32 rounded-full border border-brown-600 opacity-20 pointer-events-none"
            >
            </div>

            <div class="relative max-w-7xl mx-auto px-5 md:px-8 py-20 md:py-28">
                <div class="max-w-3xl">
                    <!-- Location badge -->
                    <div
                        class="reveal inline-flex items-center gap-2 bg-brown-800 text-caramel-300 text-sm font-medium px-4 py-1.5 rounded-full mb-8"
                    >
                        <MapPinIcon class="size-4 flex-shrink-0" />
                        <span>Serving Montreal &amp; Nearby Areas</span>
                    </div>

                    <!-- Headline -->
                    <h1
                        class="reveal reveal-delay-1 font-serif text-[clamp(2.25rem,5.5vw,4rem)] font-bold text-white leading-[1.12] mb-6"
                    >
                        Friendly Tech Help<br />
                        <span class="text-caramel-300">for Older Adults</span><br />
                        in Montreal
                    </h1>

                    <!-- Subheadline -->
                    <p
                        class="reveal reveal-delay-2 text-xl md:text-2xl text-brown-200 max-w-xl mb-10 leading-relaxed"
                    >
                        Patient, plain-English support at home, by phone, or online.<br
                        /> No jargon. No rushing. Just friendly help.
                    </p>

                    <!-- CTA buttons -->
                    <div
                        class="reveal reveal-delay-3 flex flex-col sm:flex-row gap-4 mb-14 sm:mb-16"
                    >
                        <a
                            href={bookingUrl}
                            class="inline-flex items-center justify-center gap-2 bg-caramel-400 hover:bg-caramel-500 text-white px-7 py-4 rounded-xl text-lg font-semibold transition-all hover:shadow-lg hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel-300 focus-visible:ring-offset-2 focus-visible:ring-offset-brown-950"
                        >
                            <CalendarCheckIcon class="size-5" />
                            Book a Tech Help Session
                        </a>
                        <a
                            href="#decision-helper"
                            class="inline-flex items-center justify-center gap-2 border-2 border-brown-500 text-brown-100 hover:bg-brown-800 hover:border-brown-400 px-7 py-4 rounded-xl text-lg font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brown-400 focus-visible:ring-offset-2 focus-visible:ring-offset-brown-950"
                        >
                            Ask What Service Is Right for Me
                        </a>
                    </div>

                    <!-- Trust badges -->
                    <div
                        class="reveal reveal-delay-4 flex flex-wrap gap-x-6 gap-y-3 text-brown-300 text-sm"
                    >
                        <div class="flex items-center gap-2">
                            <HomeIcon class="size-4 text-caramel-300 flex-shrink-0" />
                            <span>In-Home Visits</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <PhoneIcon class="size-4 text-caramel-300 flex-shrink-0" />
                            <span>Phone Support</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <MonitorIcon class="size-4 text-caramel-300 flex-shrink-0" />
                            <span>Remote Support</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <ShieldCheckIcon class="size-4 text-caramel-300 flex-shrink-0" />
                            <span>Private &amp; Trustworthy</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             WHY CHOOSE US
        ───────────────────────────────────────────── -->
        <section class="py-20 md:py-28 bg-white">
            <div class="max-w-6xl mx-auto px-5 md:px-8">
                <div class="text-center mb-14 reveal">
                    <h2
                        class="font-serif text-[clamp(1.875rem,3.5vw,2.75rem)] font-bold text-brown-900 mb-4"
                    >
                        Tech help that feels different
                    </h2>
                    <p class="text-lg text-brown-600 max-w-2xl mx-auto">
                        Technology should make life easier, not more stressful. That's why we do
                        things a little differently.
                    </p>
                </div>

                <div class="grid md:grid-cols-3 gap-8">
                    <div
                        class="text-center p-8 rounded-2xl bg-brown-50 hover:bg-brown-100 transition-colors reveal reveal-delay-1"
                    >
                        <div
                            class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brown-100 text-brown-700 mb-6"
                        >
                            <HeartHandshakeIcon class="size-8" />
                        </div>
                        <h3 class="text-xl font-bold text-brown-900 mb-3">
                            Patient &amp; Non-Judgmental
                        </h3>
                        <p class="text-brown-600 leading-relaxed">
                            No rushing. No confusing jargon. We explain everything clearly and
                            kindly, at whatever pace feels comfortable for you.
                        </p>
                    </div>

                    <div
                        class="text-center p-8 rounded-2xl bg-brown-50 hover:bg-brown-100 transition-colors reveal reveal-delay-2"
                    >
                        <div
                            class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brown-100 text-brown-700 mb-6"
                        >
                            <MapPinIcon class="size-8" />
                        </div>
                        <h3 class="text-xl font-bold text-brown-900 mb-3">Local to Montreal</h3>
                        <p class="text-brown-600 leading-relaxed">
                            We come to your home in Montreal and nearby areas, or help you over the
                            phone or online — whichever feels most comfortable for you.
                        </p>
                    </div>

                    <div
                        class="text-center p-8 rounded-2xl bg-brown-50 hover:bg-brown-100 transition-colors reveal reveal-delay-3"
                    >
                        <div
                            class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brown-100 text-brown-700 mb-6"
                        >
                            <ShieldCheckIcon class="size-8" />
                        </div>
                        <h3 class="text-xl font-bold text-brown-900 mb-3">You Stay in Control</h3>
                        <p class="text-brown-600 leading-relaxed">
                            We explain every change before we make it. Your privacy and comfort
                            matter. Nothing happens without your approval.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             SERVICES
        ───────────────────────────────────────────── -->
        <section id="services" class="py-20 md:py-28 bg-brown-50">
            <div class="max-w-6xl mx-auto px-5 md:px-8">
                <div class="text-center mb-14 reveal">
                    <h2
                        class="font-serif text-[clamp(1.875rem,3.5vw,2.75rem)] font-bold text-brown-900 mb-4"
                    >
                        Our Services
                    </h2>
                    <p class="text-lg text-brown-600 max-w-2xl mx-auto">
                        Choose the service that fits your needs, or <a
                            href="#decision-helper"
                            class="text-brown-700 underline underline-offset-2 hover:text-brown-900"
                            >ask us to help you decide</a
                        >.
                    </p>
                </div>

                <div class="grid md:grid-cols-2 gap-7">
                    {
                        services.map((s, i) => (
                            <div
                                id={s.id}
                                class={`reveal ${revealDelays[i] ?? ""} bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-brown-100`}
                            >
                                <div class={`h-1.5 ${s.accentClass}`} />
                                <div class="p-7 md:p-8">
                                    <div class="flex items-start gap-4 mb-5">
                                        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-brown-100 flex items-center justify-center text-brown-700">
                                            <s.icon class="size-6" />
                                        </div>
                                        <div>
                                            <h3 class="text-lg md:text-xl font-bold text-brown-900 leading-snug">
                                                {s.title}
                                            </h3>
                                            <p class="text-caramel-500 font-semibold mt-1 text-sm md:text-base">
                                                Starting at {s.remote} remote&nbsp;·&nbsp;{s.inHome}{" "}
                                                in-home
                                            </p>
                                        </div>
                                    </div>

                                    <p class="text-brown-600 mb-5 leading-relaxed">
                                        {s.description}
                                    </p>

                                    <p class="text-xs font-bold text-brown-700 uppercase tracking-widest mb-3">
                                        Examples include:
                                    </p>
                                    <ul class="space-y-1.5 mb-6">
                                        {s.examples.map((ex) => (
                                            <li class="flex items-start gap-2 text-brown-600 text-sm">
                                                <CheckCircle2Icon class="size-4 text-brown-500 mt-0.5 flex-shrink-0" />
                                                <span>{ex}</span>
                                            </li>
                                        ))}
                                    </ul>

                                    <div class="pt-5 border-t border-brown-100 space-y-3">
                                        {s.note && (
                                            <p class="text-xs text-brown-400 italic leading-relaxed">
                                                {s.note}
                                            </p>
                                        )}
                                        <a
                                            href={bookingUrl}
                                            class="inline-flex items-center gap-1.5 bg-brown-700 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-brown-800 transition-colors text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brown-700 focus-visible:ring-offset-2"
                                        >
                                            Book This Service{" "}
                                            <ChevronRightIcon class="size-4" />
                                        </a>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             ONGOING PLANS
        ───────────────────────────────────────────── -->
        <section id="plans" class="py-20 md:py-28 bg-white">
            <div class="max-w-5xl mx-auto px-5 md:px-8">
                <div class="text-center mb-14 reveal">
                    <h2
                        class="font-serif text-[clamp(1.875rem,3.5vw,2.75rem)] font-bold text-brown-900 mb-4"
                    >
                        Ongoing Support Plans
                    </h2>
                    <p class="text-lg text-brown-600 max-w-2xl mx-auto">
                        For those who want a familiar person to call before small problems become
                        frustrating.
                    </p>
                </div>

                <div class="grid md:grid-cols-2 gap-8">
                    <!-- Technology Confidence Plan -->
                    <div
                        class="relative bg-brown-950 rounded-2xl p-8 text-white overflow-hidden reveal reveal-delay-1"
                    >
                        <div
                            class="absolute top-0 right-0 w-40 h-40 bg-caramel-400 opacity-10 rounded-full translate-x-10 -translate-y-10 pointer-events-none"
                        >
                        </div>

                        <div class="flex items-center gap-3 mb-5">
                            <div
                                class="w-10 h-10 rounded-xl bg-caramel-400 flex items-center justify-center flex-shrink-0"
                            >
                                <StarIcon class="size-5 text-white" />
                            </div>
                            <span
                                class="text-xs font-bold uppercase tracking-widest text-caramel-300 bg-caramel-400/20 px-3 py-1 rounded-full"
                                >Most Popular</span
                            >
                        </div>

                        <h3 class="text-2xl font-bold mb-2">Technology Confidence Plan</h3>
                        <div class="mb-6">
                            <span class="text-4xl font-bold text-caramel-300">$39</span>
                            <span class="text-brown-300 text-lg">/month</span>
                            <p class="text-brown-400 text-sm mt-1">or $99 per quarter</p>
                        </div>

                        <ul class="space-y-3 mb-8">
                            {
                                [
                                    "One scheduled remote or phone session each month (up to 30 min)",
                                    "Priority booking when available",
                                    "10% off in-home visits and larger service packages",
                                    "Friendly reminders for updates, backups & online safety",
                                ].map((item) => (
                                    <li class="flex items-start gap-2.5 text-brown-200 text-sm leading-relaxed">
                                        <CheckCircle2Icon class="size-5 text-caramel-300 flex-shrink-0 mt-0.5" />
                                        <span>{item}</span>
                                    </li>
                                ))
                            }
                        </ul>

                        <a
                            href="#contact"
                            class="block w-full text-center bg-caramel-400 hover:bg-caramel-500 text-white px-6 py-3.5 rounded-xl font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-caramel-300 focus-visible:ring-offset-2 focus-visible:ring-offset-brown-950"
                        >
                            Get Started
                        </a>
                    </div>

                    <!-- Backup & Safety Check Plan -->
                    <div
                        class="relative bg-brown-50 border-2 border-brown-200 rounded-2xl p-8 reveal reveal-delay-2"
                    >
                        <div class="flex items-center gap-3 mb-5">
                            <div
                                class="w-10 h-10 rounded-xl bg-brown-100 flex items-center justify-center text-brown-700 flex-shrink-0"
                            >
                                <RefreshCwIcon class="size-5" />
                            </div>
                        </div>

                        <h3 class="text-2xl font-bold text-brown-900 mb-2">
                            Backup &amp; Safety Check Plan
                        </h3>
                        <div class="mb-6">
                            <span class="text-4xl font-bold text-brown-900">$19</span>
                            <span class="text-brown-500 text-lg">/month</span>
                            <p class="text-sm text-brown-500 mt-1">
                                + any third-party software or storage costs
                            </p>
                        </div>

                        <ul class="space-y-3 mb-6">
                            {
                                [
                                    "Periodic help checking your backups",
                                    "Password manager health checks",
                                    "Device update checks",
                                    "Basic security settings review",
                                ].map((item) => (
                                    <li class="flex items-start gap-2.5 text-brown-600 text-sm leading-relaxed">
                                        <CheckCircle2Icon class="size-5 text-brown-500 flex-shrink-0 mt-0.5" />
                                        <span>{item}</span>
                                    </li>
                                ))
                            }
                        </ul>

                        <p class="text-xs text-brown-400 italic leading-relaxed mb-7">
                            This plan is not continuous security monitoring and does not replace
                            professional cybersecurity services.
                        </p>

                        <a
                            href="#contact"
