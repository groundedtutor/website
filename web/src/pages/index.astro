---
import MarketingLayout from "@layouts/MarketingLayout.astro";
import {
    LaptopIcon,
    SmartphoneIcon,
    ShieldCheckIcon,
    FolderOpenIcon,
    HeartHandshakeIcon,
    MapPinIcon,
    CircleCheck,
    PhoneIcon,
    HouseIcon,
    StarIcon,
    MailIcon,
    CalendarCheckIcon,
    ChevronRightIcon,
    LockIcon,
    UserCheckIcon,
    CircleQuestionMarkIcon,
    RefreshCwIcon,
    MonitorIcon,
    ArrowRightIcon,
} from "@lucide/astro";

import { PUBLIC_SITE_PHONE, PUBLIC_BOOKING_EMAIL } from "astro:env/client";

const formattedPhone = PUBLIC_SITE_PHONE.replace(
    /(?:\+1)?(?<areaCode>\d{3})(?<part1>\d{3})(?<part2>\d{4})/g,
    (_, areaCode: string, part1: string, part2: string) => `(${areaCode}) ${part1}-${part2}`
);

const bookingUrl = "#contact";

const services = [
    {
        id: "tech-help",
        icon: LaptopIcon,
        accentClass: "bg-primary-700",
        title: "Friendly Tech Help Session",
        remote: "$79",
        inHome: "$129",
        description:
            "Get help with a specific tech problem, an everyday question, or just build your confidence with technology — at your own pace.",
        examples: [
            "Slow computer, phone, or tablet",
            "Email problems",
            "Printer & Wi-Fi issues",
            "Video calls with family, doctors, or appointments",
            "Help using an app or website",
            "General technology questions",
        ],
        goodFor: "First-time support, troubleshooting, building confidence",
        note: null,
    },
    {
        id: "device-setup",
        icon: SmartphoneIcon,
        accentClass: "bg-primary-500",
        title: "New Device Setup",
        remote: "$99",
        inHome: "$149",
        description:
            "Just got a new phone, tablet, computer, or smart device? We'll set it up properly so it works the way you need it to.",
        examples: [
            "Basic setup, updates, and account sign-in",
            "Email, contacts, and apps",
            "Transferring contacts, photos, or files where possible",
            "Printer, Wi-Fi, and Bluetooth setup",
            "Larger text, voice controls & accessibility settings",
            "Smart home setup: doorbells, cameras, thermostats",
        ],
        goodFor: "New phones, tablets, computers, printers, smart TVs, and streaming devices",
        note: "You'll need to provide account passwords, unlock codes, and pay any third-party subscription costs.",
    },
    {
        id: "safety",
        icon: ShieldCheckIcon,
        accentClass: "bg-primary-400",
        title: "Online Safety & Scam Protection Review",
        remote: "$119",
        inHome: "$159",
        description:
            "Feel more confident online. We help you recognize scams, secure your accounts, and protect what matters most to you.",
        examples: [
            "Password and account safety review",
            "Help setting up a password manager",
            "Two-factor authentication setup",
            "Recognizing scam emails, calls & fake websites",
            "Social media privacy settings",
            "Safer online shopping and banking habits",
        ],
        goodFor: "Anyone worried about scams, suspicious emails, or online security",
        note: "This service helps reduce risk but cannot guarantee complete protection from all scams, fraud, or malware.",
    },
    {
        id: "backup",
        icon: FolderOpenIcon,
        accentClass: "bg-primary-400",
        title: "Photo, File & Backup Organization",
        remote: "$119",
        inHome: "$159",
        description:
            "Protect your memories and important documents. We'll organize your files and set up backups so you don't lose what matters.",
        examples: [
            "Reviewing and setting up cloud or external-drive backups",
            "Organizing photos, videos, and documents",
            "Email cleanup and file-saving guidance",
            "Scanning old photos where equipment and time allow",
            "Creating simple folders and albums easy to find",
        ],
        goodFor: "Anyone whose photos and files are scattered or unprotected",
        note: "Backup services reduce the chance of data loss but cannot guarantee every file can be recovered, transferred, or preserved.",
    },
];

const bookingSteps = [
    {
        number: "1",
        icon: PhoneIcon,
        title: "Tell Us What You Need",
        desc: "Call, email, or fill out our contact form. Describe your problem in plain language — no technical terms needed.",
    },
    {
        number: "2",
        icon: HeartHandshakeIcon,
        title: "We Recommend the Best Option",
        desc: "We'll suggest the right service and advise whether remote or in-home support makes more sense for your situation.",
    },
    {
        number: "3",
        icon: CalendarCheckIcon,
        title: "Choose a Time That Works",
        desc: "Pick an appointment time that's convenient for you. We'll work around your schedule.",
    },
    {
        number: "4",
        icon: UserCheckIcon,
        title: "We Explain Everything First",
        desc: "Before making any changes, we explain what we're going to do and ask for your approval. You stay in control.",
    },
    {
        number: "5",
        icon: CircleCheck,
        title: "Simple Next Steps After",
        desc: "After your session you'll receive clear, plain-language next steps you can keep and refer back to.",
    },
];

const decisionItems = [
    { quote: "My computer is slow.", service: "Friendly Tech Help Session", anchor: "#tech-help" },
    {
        quote: "I bought a new phone, tablet, or computer.",
        service: "New Device Setup",
        anchor: "#device-setup",
    },
    {
        quote: "I'm worried about scams or passwords.",
        service: "Online Safety & Scam Protection Review",
        anchor: "#safety",
    },
    {
        quote: "My photos and files are everywhere.",
        service: "Photo, File & Backup Organization",
        anchor: "#backup",
    },
    { quote: "I want ongoing help.", service: "Ongoing Support Plan", anchor: "#plans" },
];
---

<MarketingLayout title="Friendly Tech Help for Older Adults in Montreal">
    <!-- Skip nav for accessibility -->
    <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-primary-700 focus:px-4 focus:py-2 focus:text-white"
    >
        Skip to main content
    </a>

    <main id="main-content">
        <!-- ─────────────────────────────────────────────
             HERO
        ───────────────────────────────────────────── -->
        <section
            class="relative flex min-h-screen items-center overflow-hidden bg-surface-50-950 pt-16 text-surface-950-50 md:pt-20"
        >
            <!-- Ambient glows -->
            <div
                class="h-md pointer-events-none absolute top-1/3 left-1/4 w-md rounded-full bg-primary-700 opacity-20 blur-3xl"
            >
            </div>
            <div
                class="pointer-events-none absolute right-1/5 bottom-1/4 h-64 w-64 rounded-full bg-primary-400 opacity-10 blur-3xl"
            >
            </div>

            <!-- Decorative rings -->
            <div
                class="pointer-events-none absolute top-24 right-8 h-56 w-56 rounded-full border border-primary-700 opacity-25 md:right-20"
            >
            </div>
            <div
                class="pointer-events-none absolute top-40 right-20 h-32 w-32 rounded-full border border-primary-600 opacity-20 md:right-36"
            >
            </div>

            <div class="relative mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
                <div class="max-w-3xl">
                    <!-- Location badge -->
                    <div
                        class="bg-primary-100-800 text-primary-800-100 mb-8 inline-flex reveal items-center gap-2 rounded-full px-4 py-1.5 text-sm font-medium"
                    >
                        <MapPinIcon class="size-4 shrink-0" />
                        <span>Serving Montreal &amp; Nearby Areas</span>
                    </div>

                    <!-- Headline -->
                    <h1
                        class="mb-6 reveal font-serif text-[clamp(2.25rem,5.5vw,4rem)] leading-[1.12] font-bold text-surface-950-50 delay-100"
                    >
                        Friendly Tech Help<br />
                        <span class="text-primary-700-300">for Older Adults</span><br />
                        in Montreal
                    </h1>

                    <!-- Subheadline -->
                    <p
                        class="mb-10 max-w-xl reveal text-xl leading-relaxed text-surface-700-300 delay-200"
                    >
                        Patient, plain-English support at home, by phone, or online. No jargon. No
                        rushing. Just friendly help.
                    </p>

                    <!-- CTA buttons -->
                    <div class="mb-14 flex reveal flex-col gap-4 delay-300 sm:mb-16 sm:flex-row">
                        <a
                            href={bookingUrl}
                            class="btn gap-2 preset-filled-primary-500 px-7 py-5 font-semibold btn-lg focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-50-950 focus-visible:outline-none"
                        >
                            <CalendarCheckIcon class="size-5" />
                            Book a Tech Help Session
                        </a>
                        <a
                            href="#decision-helper"
                            class="btn gap-2 preset-outlined-primary-500 px-7 py-5 font-semibold btn-lg focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-50-950 focus-visible:outline-none"
                        >
                            Ask What Service Is Right for Me
                        </a>
                    </div>

                    <!-- Trust badges -->
                    <div
                        class="flex reveal flex-wrap gap-x-6 gap-y-3 text-sm text-surface-700-300 delay-400"
                    >
                        <div class="flex items-center gap-2">
                            <HouseIcon class="size-4 shrink-0 text-surface-700-300" />
                            <span>In-Home Visits</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <PhoneIcon class="size-4 shrink-0 text-surface-700-300" />
                            <span>Phone Support</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <MonitorIcon class="size-4 shrink-0 text-surface-700-300" />
                            <span>Remote Support</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <ShieldCheckIcon class="size-4 shrink-0 text-surface-700-300" />
                            <span>Private &amp; Trustworthy</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             WHY CHOOSE US
        ───────────────────────────────────────────── -->
        <section class="relative overflow-hidden bg-surface-300-700 py-20 md:py-28">
            <div class="mx-auto max-w-6xl px-5 md:px-8">
                <div class="mb-14 max-w-3xl reveal">
                    <p
                        class="mb-4 text-xs font-semibold tracking-[0.22em] text-primary-300-700 uppercase"
                    >
                        Why GroundedTutor
                    </p>
                    <h2
                        class="mb-4 font-serif text-[clamp(2rem,4vw,3rem)] leading-tight font-bold text-surface-950-50"
                    >
                        Tech help that feels different
                    </h2>
                    <p class="text-lg leading-relaxed text-surface-700-300">
                        Technology should make life easier, not more stressful. That's why we do
                        things a little differently.
                    </p>
                </div>

                <div class="grid gap-6 md:grid-cols-3">
                    <article
                        class="group preset-filled-surface-50 reveal card border border-surface-200/70 p-7 shadow-[0_18px_50px_rgba(84,59,35,0.06)] backdrop-blur-sm transition-all delay-100 duration-300 hover:-translate-y-1 hover:border-primary-300 hover:shadow-[0_22px_60px_rgba(84,59,35,0.10)]"
                    >
                        <div
                            class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-100 text-primary-700"
                        >
                            <HeartHandshakeIcon class="size-7" />
                        </div>
                        <h3 class="mb-3 text-xl font-bold text-surface-950-50">
                            Patient &amp; Non-Judgmental
                        </h3>
                        <p class="leading-relaxed text-surface-700-300">
                            No rushing. No confusing jargon. We explain everything clearly and kindly,
                            at whatever pace feels comfortable for you.
                        </p>
                    </article>

                    <article
                        class="group preset-filled-surface-50 reveal card border border-surface-200/70 p-7 shadow-[0_18px_50px_rgba(84,59,35,0.06)] backdrop-blur-sm transition-all delay-200 duration-300 hover:-translate-y-1 hover:border-primary-300 hover:shadow-[0_22px_60px_rgba(84,59,35,0.10)]"
                    >
                        <div
                            class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-100 text-primary-700"
                        >
                            <MapPinIcon class="size-7" />
                        </div>
                        <h3 class="mb-3 text-xl font-bold text-surface-950-50">Local to Montreal</h3>
                        <p class="leading-relaxed text-surface-700-300">
                            We come to your home in Montreal and nearby areas, or help you over the
                            phone or online — whichever feels most comfortable for you.
                        </p>
                    </article>

                    <article
                        class="group preset-filled-surface-50 reveal card border border-surface-200/70 p-7 shadow-[0_18px_50px_rgba(84,59,35,0.06)] backdrop-blur-sm transition-all delay-300 duration-300 hover:-translate-y-1 hover:border-primary-300 hover:shadow-[0_22px_60px_rgba(84,59,35,0.10)]"
                    >
                        <div
                            class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-100 text-primary-700"
                        >
                            <ShieldCheckIcon class="size-7" />
                        </div>
                        <h3 class="mb-3 text-xl font-bold text-surface-950-50">
                            You Stay in Control
                        </h3>
                        <p class="leading-relaxed text-surface-700-300">
                            We explain every change before we make it. Your privacy and comfort
                            matter. Nothing happens without your approval.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             SERVICES
        ───────────────────────────────────────────── -->
        <section id="services" class="bg-surface-100-900 py-20 md:py-28">
            <div class="mx-auto max-w-6xl px-5 md:px-8">
                <div class="mb-14 reveal text-center">
                    <p
                        class="mb-4 text-xs font-semibold tracking-[0.22em] text-primary-500 uppercase"
                    >
                        Services
                    </p>
                    <h2
                        class="mb-4 font-serif text-[clamp(2rem,4vw,3rem)] leading-tight font-bold text-surface-950-50"
                    >
                        Support designed around real life
                    </h2>
                    <p class="mx-auto max-w-2xl text-lg text-surface-700-300">
                        Choose the service that fits your needs, or <a
                            href="#decision-helper"
                            class="font-medium text-primary-700-300 underline underline-offset-2 transition-colors hover:text-primary-800-200"
                            >ask us to help you decide</a
                        >.
                    </p>
                </div>

                <div class="grid gap-6 md:grid-cols-2">
                    {
                        services.map((s, i) => (
                            <article
                                id={s.id}
                                class={`group reveal overflow-hidden rounded-[1.75rem] border border-surface-300-700 bg-surface-50-950 shadow-[0_24px_80px_rgba(9,18,27,0.08)] transition-all delay-150 duration-300 hover:-translate-y-1 hover:shadow-[0_24px_90px_rgba(9,18,27,0.12)]`}
                            >
                                <div class={`h-1.5 ${s.accentClass}`} />
                                <div class="p-7 md:p-8">
                                    <div class="mb-6 flex items-start gap-4">
                                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-surface-300-700 bg-surface-200-800 text-primary-700-300">
                                            <s.icon class="size-6" />
                                        </div>
                                        <div>
                                            <h3 class="text-xl font-bold text-surface-950-50">
                                                {s.title}
                                            </h3>
                                            <p class="mt-1 text-sm font-semibold text-primary-600-400">
                                                Starting at {s.remote} remote · {s.inHome} in-home
                                            </p>
                                        </div>
                                    </div>

                                    <p class="mb-6 leading-relaxed text-surface-700-300">
                                        {s.description}
                                    </p>

                                    <div class="mb-6 rounded-2xl border border-surface-300-700 bg-surface-100-900 p-4">
                                        <p class="mb-3 text-xs font-bold tracking-[0.22em] text-primary-700-300 uppercase">
                                            Examples include:
                                        </p>
                                        <ul class="space-y-2">
                                            {s.examples.map((ex) => (
                                                <li class="flex items-start gap-2 text-sm leading-relaxed text-surface-700-300">
                                                    <CircleCheck class="mt-0.5 size-4 shrink-0 text-primary-600-400" />
                                                    <span>{ex}</span>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>

                                    <div class="space-y-4 border-t border-surface-300-700 pt-5">
                                        {s.note && (
                                            <p class="text-xs leading-relaxed text-surface-600-400 italic">
                                                {s.note}
                                            </p>
                                        )}
                                        <a
                                            href={bookingUrl}
                                            class="inline-flex items-center gap-2 rounded-xl bg-primary-700 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-800 focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-50-950 focus-visible:outline-none"
                                        >
                                            Book This Service <ChevronRightIcon class="size-4" />
                                        </a>
                                    </div>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             ONGOING PLANS
        ───────────────────────────────────────────── -->
        <section id="plans" class="bg-surface-50-950 py-20 md:py-28">
            <div class="mx-auto max-w-5xl px-5 md:px-8">
                <div class="mb-14 reveal text-center">
                    <p
                        class="mb-4 text-xs font-semibold tracking-[0.22em] text-primary-600 uppercase"
                    >
                        Ongoing support
                    </p>
                    <h2
                        class="mb-4 font-serif text-[clamp(2rem,4vw,3rem)] leading-tight font-bold text-surface-950-50"
                    >
                        Ongoing Support Plans
                    </h2>
                    <p class="mx-auto max-w-2xl text-lg text-surface-700-300">
                        For those who want a familiar person to call before small problems become
                        frustrating.
                    </p>
                </div>

                <div class="grid gap-6 md:grid-cols-2">
                    <article
                        class="bg-surface-900-50 relative reveal overflow-hidden rounded-[1.9rem] border border-surface-700/80 p-8 text-surface-50-950 shadow-[0_30px_90px_rgba(15,23,42,0.18)] delay-100"
                    >
                        <div
                            class="pointer-events-none absolute -top-8 right-0 h-40 w-40 rounded-full bg-primary-400/15 blur-2xl"
                        >
                        </div>
                        <div class="relative">
                            <div class="mb-5 flex items-center gap-3">
                                <div
                                    class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary-400/20 text-primary-200"
                                >
                                    <StarIcon class="size-5" />
                                </div>
                                <span
                                    class="rounded-full border border-primary-400/30 bg-primary-400/10 px-3 py-1 text-[10px] font-bold tracking-[0.22em] text-primary-200 uppercase"
                                >
                                    Most Popular
                                </span>
                            </div>

                            <h3 class="mb-3 text-2xl font-bold text-surface-50-950">
                                Technology Confidence Plan
                            </h3>
                            <div class="mb-6 flex items-end gap-2">
                                <span class="text-4xl font-bold text-primary-200">$39</span>
                                <span class="pb-1 text-lg text-surface-300-700">/month</span>
                            </div>
                            <p class="mb-6 text-sm text-surface-300-700">or $99 per quarter</p>

                            <ul class="mb-8 space-y-3">
                                {
                                    [
                                        "One scheduled remote or phone session each month (up to 30 min)",
                                        "Priority booking when available",
                                        "10% off in-home visits and larger service packages",
                                        "Friendly reminders for updates, backups & online safety",
                                    ].map((item) => (
                                        <li class="flex items-start gap-2.5 text-sm leading-relaxed text-surface-100-900">
                                            <CircleCheck class="mt-0.5 size-4 shrink-0 text-primary-300" />
                                            <span>{item}</span>
                                        </li>
                                    ))
                                }
                            </ul>

                            <a
                                href="#contact"
                                class="btn block w-full preset-filled-primary-500 px-6 py-3.5 text-center font-semibold focus-visible:ring-2 focus-visible:ring-primary-300 focus-visible:ring-offset-2 focus-visible:ring-offset-primary-950 focus-visible:outline-none"
                            >
                                Get Started
                            </a>
                        </div>
                    </article>

                    <article
                        class="relative reveal rounded-[1.9rem] border border-surface-200/70 bg-surface-50-950 p-8 shadow-[0_20px_60px_rgba(67,47,23,0.06)] delay-200"
                    >
                        <div class="mb-5 flex items-center gap-3">
                            <div
                                class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary-200 text-primary-700"
                            >
                                <RefreshCwIcon class="size-5" />
                            </div>
                        </div>

                        <h3 class="mb-3 text-2xl font-bold text-surface-950-50">
                            Backup &amp; Safety Check Plan
                        </h3>
                        <div class="mb-6 flex items-end gap-2">
                            <span class="text-4xl font-bold text-surface-950-50">$19</span>
                            <span class="pb-1 text-lg text-surface-600-400">/month</span>
                        </div>
                        <p class="mb-6 text-sm text-surface-600-400">
                            + any third-party software or storage costs
                        </p>

                        <ul class="mb-7 space-y-3">
                            {
                                [
                                    "Periodic help checking your backups",
                                    "Password manager health checks",
                                    "Device update checks",
                                    "Basic security settings review",
                                ].map((item) => (
                                    <li class="flex items-start gap-2.5 text-sm leading-relaxed text-surface-700-300">
                                        <CircleCheck class="mt-0.5 size-4 shrink-0 text-primary-500" />
                                        <span>{item}</span>
                                    </li>
                                ))
                            }
                        </ul>

                        <p class="mb-7 text-xs leading-relaxed text-surface-600-400 italic">
                            This plan is not continuous security monitoring and does not replace
                            professional cybersecurity services.
                        </p>

                        <a
                            href="#contact"
                            class="preset-filled-primary-700 btn block w-full px-6 py-3.5 text-center font-semibold focus-visible:ring-2 focus-visible:ring-primary-700 focus-visible:ring-offset-2 focus-visible:outline-none"
                        >
                            Get Started
                        </a>
                    </article>
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             HOW BOOKING WORKS
        ───────────────────────────────────────────── -->
        <section id="how-it-works" class="bg-surface-100-900 py-20 md:py-28">
            <div class="mx-auto max-w-6xl px-5 md:px-8">
                <div class="mb-14 reveal text-center">
                    <p
                        class="mb-4 text-xs font-semibold tracking-[0.22em] text-primary-600 uppercase"
                    >
                        How it works
                    </p>
                    <h2
                        class="mb-4 font-serif text-[clamp(2rem,4vw,3rem)] leading-tight font-bold text-surface-950-50"
                    >
                        How Booking Works
                    </h2>
                    <p class="mx-auto max-w-2xl text-lg text-surface-700-300">
                        Getting help is simple. Here's what to expect from start to finish.
                    </p>
                </div>

                <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-5">
                    {
                        bookingSteps.map((step, i) => (
                            <div
                                class:list={[
                                    "preset-filled-surface-50 reveal card border border-surface-200/70 p-5 shadow-[0_18px_50px_rgba(66,47,20,0.05)]",
                                    `delay-${(i + 1) * 100}`,
                                ]}
                            >
                                <div class="mb-5 flex items-center justify-between">
                                    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-700 text-lg font-bold text-white">
                                        {step.number}
                                    </span>
                                    <step.icon class="size-5 text-primary-600" />
                                </div>
                                <h3 class="mb-2 text-base font-bold text-surface-950-50">
                                    {step.title}
                                </h3>
                                <p class="text-sm leading-relaxed text-surface-700-300">
                                    {step.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             REMOTE vs IN-HOME + SERVICE AREA
        ───────────────────────────────────────────── -->
        <section class="bg-surface-50-950 py-20 md:py-28">
            <div class="mx-auto max-w-6xl px-5 md:px-8">
                <div class="mb-14 reveal text-center">
                    <p
                        class="mb-4 text-xs font-semibold tracking-[0.22em] text-primary-600 uppercase"
                    >
                        Flexible support
                    </p>
                    <h2
