---
import MarketingLayout from "@layouts/MarketingLayout.astro";
import {
    LaptopIcon,
    SmartphoneIcon,
    ShieldCheckIcon,
    FolderOpenIcon,
    HeartHandshakeIcon,
    MapPinIcon,
    CircleCheck,
    PhoneIcon,
    HouseIcon,
    StarIcon,
    MailIcon,
    CalendarCheckIcon,
    ChevronRightIcon,
    LockIcon,
    UserCheckIcon,
    CircleQuestionMarkIcon,
    RefreshCwIcon,
    MonitorIcon,
    ArrowRightIcon,
} from "@lucide/astro";

import {
    PUBLIC_SITE_PHONE,
    PUBLIC_BOOKING_EMAIL,
    PUBLIC_SITE_PHONE_FORMATTED,
} from "astro:env/client";

const formattedPhone = PUBLIC_SITE_PHONE.replace(
    /(?:\+1)?(?<areaCode>\d{3})(?<part1>\d{3})(?<part2>\d{4})/g,
    (_, areaCode: string, part1: string, part2: string) => `(${areaCode}) ${part1}-${part2}`
);

const bookingUrl = "#contact";

const services = [
    {
        id: "tech-help",
        icon: LaptopIcon,
        title: "Friendly Tech Help Session",
        remote: "$79",
        inHome: "$129",
        description:
            "Get help with a specific tech problem, an everyday question, or just build your confidence with technology — at your own pace.",
        examples: [
            "Slow computer, phone, or tablet",
            "Email problems",
            "Printer & Wi-Fi issues",
            "Video calls with family, doctors, or appointments",
            "Help using an app or website",
            "General technology questions",
        ],
        goodFor: "First-time support, troubleshooting, building confidence",
        note: null,
    },
    {
        id: "device-setup",
        icon: SmartphoneIcon,
        title: "New Device Setup",
        remote: "$99",
        inHome: "$149",
        description:
            "Just got a new phone, tablet, computer, or smart device? We'll set it up properly so it works the way you need it to.",
        examples: [
            "Basic setup, updates, and account sign-in",
            "Email, contacts, and apps",
            "Transferring contacts, photos, or files where possible",
            "Printer, Wi-Fi, and Bluetooth setup",
            "Larger text, voice controls & accessibility settings",
            "Smart home setup: doorbells, cameras, thermostats",
        ],
        goodFor: "New phones, tablets, computers, printers, smart TVs, and streaming devices",
        note: "You'll need to provide account passwords, unlock codes, and pay any third-party subscription costs.",
    },
    {
        id: "safety",
        icon: ShieldCheckIcon,
        title: "Online Safety & Scam Protection Review",
        remote: "$119",
        inHome: "$159",
        description:
            "Feel more confident online. We help you recognize scams, secure your accounts, and protect what matters most to you.",
        examples: [
            "Password and account safety review",
            "Help setting up a password manager",
            "Two-factor authentication setup",
            "Recognizing scam emails, calls & fake websites",
            "Social media privacy settings",
            "Safer online shopping and banking habits",
        ],
        goodFor: "Anyone worried about scams, suspicious emails, or online security",
        note: "This service helps reduce risk but cannot guarantee complete protection from all scams, fraud, or malware.",
    },
    {
        id: "backup",
        icon: FolderOpenIcon,
        title: "Photo, File & Backup Organization",
        remote: "$119",
        inHome: "$159",
        description:
            "Protect your memories and important documents. We'll organize your files and set up backups so you don't lose what matters.",
        examples: [
            "Reviewing and setting up cloud or external-drive backups",
            "Organizing photos, videos, and documents",
            "Email cleanup and file-saving guidance",
            "Scanning old photos where equipment and time allow",
            "Creating simple folders and albums easy to find",
        ],
        goodFor: "Anyone whose photos and files are scattered or unprotected",
        note: "Backup services reduce the chance of data loss but cannot guarantee every file can be recovered, transferred, or preserved.",
    },
];

const bookingSteps = [
    {
        number: "1",
        icon: PhoneIcon,
        title: "Tell Us What You Need",
        desc: "Call, email, or fill out our contact form. Describe your problem in plain language — no technical terms needed.",
    },
    {
        number: "2",
        icon: HeartHandshakeIcon,
        title: "We Recommend the Best Option",
        desc: "We'll suggest the right service and advise whether remote or in-home support makes more sense for your situation.",
    },
    {
        number: "3",
        icon: CalendarCheckIcon,
        title: "Choose a Time That Works",
        desc: "Pick an appointment time that's convenient for you. We'll work around your schedule.",
    },
    {
        number: "4",
        icon: UserCheckIcon,
        title: "We Explain Everything First",
        desc: "Before making any changes, we explain what we're going to do and ask for your approval. You stay in control.",
    },
    {
        number: "5",
        icon: CircleCheck,
        title: "Simple Next Steps After",
        desc: "After your session you'll receive clear, plain-language next steps you can keep and refer back to.",
    },
];

const decisionItems = [
    { quote: "My computer is slow.", service: "Friendly Tech Help Session", anchor: "#tech-help" },
    {
        quote: "I bought a new phone, tablet, or computer.",
        service: "New Device Setup",
        anchor: "#device-setup",
    },
    {
        quote: "I'm worried about scams or passwords.",
        service: "Online Safety & Scam Protection Review",
        anchor: "#safety",
    },
    {
        quote: "My photos and files are everywhere.",
        service: "Photo, File & Backup Organization",
        anchor: "#backup",
    },
    { quote: "I want ongoing help.", service: "Ongoing Support Plan", anchor: "#plans" },
];
---

<MarketingLayout title="Friendly Tech Help for Older Adults in Montreal">
    <!-- ─────────────────────────────────────────────
        HERO
    ───────────────────────────────────────────── -->
    <section
        class="relative flex min-h-screen items-center overflow-hidden bg-primary-50-950 pt-16 text-surface-950-50 md:pt-20"
    >
        <!-- Ambient glows -->
        <div
            class="h-md pointer-events-none absolute top-1/3 left-1/4 w-md rounded-full bg-primary-700/20 blur-3xl"
        >
        </div>
        <div
            class="pointer-events-none absolute right-1/5 bottom-1/4 h-64 w-64 rounded-full bg-primary-400/10 blur-3xl"
        >
        </div>

        <!-- Decorative rings -->
        <div
            class="pointer-events-none absolute top-24 right-8 h-56 w-56 rounded-full border border-primary-700 opacity-25 md:right-20"
        >
        </div>
        <div
            class="pointer-events-none absolute top-40 right-20 h-32 w-32 rounded-full border border-primary-600 opacity-20 md:right-36"
        >
        </div>

        <div class="relative mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
            <div class="max-w-3xl">
                <!-- Location badge -->
                <div
                    class="mb-8 inline-flex reveal items-center gap-2 rounded-full bg-primary-100-900 px-4 py-1.5 text-base font-medium text-primary-900-100"
                >
                    <MapPinIcon class="size-4 shrink-0" />
                    <span>Serving Montreal &amp; Nearby Areas</span>
                </div>

                <!-- Headline -->
                <h1
                    class="mb-6 reveal font-serif text-7xl leading-[1.12] font-bold text-surface-800-200 delay-100"
                >
                    Friendly Tech Help<br />
                    <span class="text-primary-800-200">for Older Adults</span><br />
                    in Montreal
                </h1>

                <!-- Subheadline -->
                <p
                    class="mb-10 max-w-xl reveal text-xl leading-relaxed text-surface-700-300 delay-200"
                >
                    Patient, plain-English support at home, by phone, or online. No jargon. No
                    rushing. Just friendly help.
                </p>

                <!-- CTA buttons -->
                <div class="mb-10 flex reveal flex-col gap-4 delay-300 sm:mb-12 sm:flex-row">
                    <a
                        href={bookingUrl}
                        class="btn gap-2 preset-filled-primary-600-400 px-7 py-5 font-semibold btn-xl focus-visible:ring-2 focus-visible:ring-primary-400-600 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-50-950 focus-visible:outline-none"
                    >
                        <CalendarCheckIcon class="size-5" />
                        Book a Tech Help Session
                    </a>
                    <a
                        href="#decision-helper"
                        class="btn border-2! bg-secondary-400-600/20 px-7 py-5 font-semibold text-secondary-contrast-400-600 btn-xl hover:bg-secondary-400-600/40 focus-visible:ring-2 focus-visible:ring-primary-600-400 focus-visible:ring-offset-2 focus-visible:outline-none"
                    >
                        Ask What Service Is Right for Me
                    </a>
                </div>

                <!-- Trust badges -->
                <div
                    class="flex reveal flex-wrap gap-x-6 gap-y-3 text-sm text-surface-700-300 delay-400"
                >
                    <div class="flex items-center gap-2">
                        <HouseIcon class="size-4 shrink-0 text-primary-700-300" />
                        <span>In-Home Visits</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <PhoneIcon class="size-4 shrink-0 text-primary-700-300" />
                        <span>Phone Support</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <MonitorIcon class="size-4 shrink-0 text-primary-700-300" />
                        <span>Remote Support</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <ShieldCheckIcon class="size-4 shrink-0 text-primary-700-300" />
                        <span>Private &amp; Trustworthy</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TODO: Blend the backgrounds -->

    <!-- ─────────────────────────────────────────────
        WHY CHOOSE US
    ───────────────────────────────────────────── -->
    <section class="relative overflow-hidden bg-primary-100-900 py-20 md:py-28">
        <div class="sect-content">
            <div class="mx-auto mb-14 max-w-4xl reveal text-center">
                <h2 class="mb-4 sect-heading">Tech help that feels different</h2>
                <p class="sect-subheading">
                    Technology should make life easier, not more stressful. That's why we do things a
                    little differently.
                </p>
            </div>

            <div class="grid gap-6 md:grid-cols-3">
                <article
                    class="group reveal card preset-filled-tertiary-100-900 p-7 shadow-sm backdrop-blur-sm transition-all duration-300 hover:shadow-secondary-200-800"
                >
                    <div
                        class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-surface-300-700 preset-filled-primary-200-800"
                    >
                        <HeartHandshakeIcon class="size-7" aria-hidden="false" />
                    </div>
                    <h3 class="mb-3 text-xl font-bold text-surface-950-50">
                        Patient &amp; Non-Judgmental
                    </h3>
                    <p class="leading-relaxed text-surface-700-300">
                        No rushing. No confusing jargon. We explain everything clearly and kindly, at
                        whatever pace feels comfortable for you.
                    </p>
                </article>

                <article
                    class="group reveal card preset-filled-tertiary-100-900 p-7 shadow-sm backdrop-blur-sm transition-all duration-300 hover:shadow-secondary-200-800"
                >
                    <div
                        class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-surface-300-700 preset-filled-primary-200-800"
                    >
                        <MapPinIcon class="size-7" />
                    </div>
                    <h3 class="mb-3 text-xl font-bold text-surface-950-50">Local to Montreal</h3>
                    <p class="leading-relaxed text-surface-700-300">
                        We come to your home in Montreal and nearby areas, or help you over the phone
                        or online — whichever feels most comfortable for you.
                    </p>
                </article>

                <article
                    class="group reveal card preset-filled-tertiary-100-900 p-7 shadow-sm backdrop-blur-sm transition-all duration-300 hover:shadow-secondary-200-800"
                >
                    <div
                        class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-surface-300-700 preset-filled-primary-200-800"
                    >
                        <ShieldCheckIcon class="size-7" />
                    </div>
                    <h3 class="mb-3 text-xl font-bold text-surface-950-50">You Stay in Control</h3>
                    <p class="leading-relaxed text-surface-700-300">
                        We explain every change before we make it. Your privacy and comfort matter.
                        Nothing happens without your approval.
                    </p>
                </article>
            </div>
        </div>
    </section>

    <!-- ─────────────────────────────────────────────
        SERVICES
    ───────────────────────────────────────────── -->
    <section id="services" class="bg-primary-100-900/80 py-20 md:py-28">
        <div class="sect-content">
            <div class="mb-14 reveal text-center">
                <h2 class="mb-4 sect-heading text-surface-600-400">
                    Support designed around real life
                </h2>
                <p class="sect-subheading dark:text-surface-contrast-100-900">
                    Choose the service that fits your needs, or <a
                        href="#decision-helper"
                        class="font-medium text-primary-700-300 underline underline-offset-2 transition-colors hover:text-primary-800-200"
                        >ask us to help you decide</a
                    >.
                </p>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
                {
                    services.map((s, i) => (
                        <article
                            id={s.id}
                            class="group reveal overflow-hidden rounded-2xl border border-surface-200/70 preset-filled-primary-200-800 shadow-md shadow-surface-contrast-50-950/10 transition-all delay-150 duration-300"
                        >
                            <div class="h-1.5 bg-primary-400-600" />
                            <div class="flex h-full flex-col p-7 md:p-8">
                                <div class="mb-6 flex items-start gap-4">
                                    <div class="flex size-12 shrink-0 items-center justify-center rounded-xl border border-surface-300-700 preset-filled-primary-200-800">
                                        <s.icon class="size-6" />
                                    </div>
                                    <div>
                                        <h3 class="text-xl font-bold text-surface-950-50">
                                            {s.title}
                                        </h3>
                                        <p class="mt-1 text-sm font-semibold text-primary-800-200">
                                            Starting at {s.remote} remote · {s.inHome} in-home
                                        </p>
                                    </div>
                                </div>

                                <p class="mb-6 leading-relaxed">{s.description}</p>

                                <div class="mb-6 rounded-2xl border preset-outlined-primary-200-800 preset-filled-surface-50-950 p-4">
                                    <p class="mb-3 text-xs font-bold tracking-[0.22em] text-surface-600-400 uppercase">
                                        Examples include:
                                    </p>
                                    <ul class="space-y-2">
                                        {s.examples.map((ex) => (
                                            <li class="flex items-start gap-2 text-sm leading-relaxed">
                                                <CircleCheck class="mt-0.5 size-4 shrink-0 text-primary-700-300" />
                                                <span>{ex}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>

                                <div class="flex basis-full flex-col space-y-4 border-t border-surface-300-700 pt-5">
                                    {s.note && (
                                        <p class="text-xs leading-relaxed text-primary-800-200 italic">
                                            {s.note}
                                        </p>
                                    )}
                                    <a
                                        href={bookingUrl}
                                        class="mt-auto btn preset-filled-primary-600-400 py-4 font-semibold transition-colors"
                                    >
                                        Book This Service <ChevronRightIcon class="size-4" />
                                    </a>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ─────────────────────────────────────────────
        ONGOING PLANS
    ───────────────────────────────────────────── -->
    <section id="plans" class="bg-primary-50-950/70 py-20 md:py-28">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
            <div class="mb-14 reveal text-center">
                <h2 class="mb-4 sect-heading">Ongoing Support Plans</h2>
                <p class="sect-subheading">
                    For those who want a familiar person to call before small problems become
                    frustrating.
                </p>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
                <article
                    class="relative flex reveal flex-col overflow-hidden rounded-4xl border border-surface-700-300/80 bg-primary-200-800/70 p-8 text-surface-50-950 shadow-surface-contrast-50-950/10 delay-100"
                >
                    <div class="relative flex h-full flex-col">
                        <div class="mb-5 flex items-center gap-3">
                            <div
                                class="flex size-12 shrink-0 items-center justify-center rounded-2xl preset-filled-primary-800-200"
                            >
                                <StarIcon class="size-5" />
                            </div>
                            <span
                                class="rounded-full border border-primary-400/30 bg-primary-200-800 px-3 py-1 text-xs font-bold tracking-[0.22em] text-primary-800-200 uppercase"
                            >
                                Most Popular
                            </span>
                        </div>

                        <h3 class="mb-3 text-2xl font-bold text-surface-950-50">
                            Technology Confidence Plan
                        </h3>
                        <div class="mb-6">
                            <span class="text-4xl font-bold text-primary-800-200">$39</span>
                            <span class="pb-1 text-lg text-surface-800-200">/month</span>
                            <p class="mb-6 text-base text-surface-800-200">or $99 per quarter</p>
                        </div>

                        <ul class="mb-8 space-y-3">
                            {
                                [
                                    "One scheduled remote or phone session each month (up to 30 min)",
                                    "Priority booking when available",
                                    "10% off in-home visits and larger service packages",
                                    "Friendly reminders for updates, backups & online safety",
                                ].map((item) => (
                                    <li class="flex items-start gap-2.5 text-sm leading-relaxed text-surface-900-100">
                                        <CircleCheck class="mt-0.5 size-4 shrink-0 text-primary-800-200" />
                                        <span>{item}</span>
                                    </li>
                                ))
                            }
                        </ul>

                        <a
                            href="#contact"
                            class="mt-auto btn w-full preset-filled-primary-800-200 px-6 py-3.5 text-center font-semibold"
                        >
                            Purchase Plan
                        </a>
                    </div>
                </article>

                <article
                    class="relative flex reveal flex-col rounded-4xl border border-surface-200/70 bg-primary-100-900/50 p-8 shadow-surface-contrast-50-950/10"
                >
                    <div class="mb-5 flex items-center gap-3">
                        <div
                            class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary-200-800 text-primary-700-300"
                        >
                            <RefreshCwIcon class="size-5" />
                        </div>
                    </div>

                    <h3 class="mb-3 text-2xl font-bold text-surface-950-50">
                        Backup &amp; Safety Check Plan
                    </h3>
                    <div class="mb-6 flex items-end gap-2">
                        <span class="text-4xl font-bold text-surface-950-50">$19</span>
                        <span class="pb-1 text-lg text-surface-600-400">/month</span>
                    </div>
                    <p class="mb-6 text-sm text-surface-600-400">
                        + any third-party software or storage costs
                    </p>

                    <ul class="mb-8 space-y-3">
                        {
                            [
                                "Periodic help checking your backups",
                                "Password manager health checks",
                                "Device update checks",
                                "Basic security settings review",
                            ].map((item) => (
                                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-surface-700-300">
                                    <CircleCheck class="mt-0.5 size-4 shrink-0 text-primary-500" />
                                    <span>{item}</span>
                                </li>
                            ))
                        }
                    </ul>

                    <p class="mb-8 text-xs leading-relaxed text-surface-600-400 italic">
                        This plan is not continuous security monitoring and does not replace
                        professional cybersecurity services.
                    </p>

                    <a
                        href="#contact"
                        class="mt-auto btn block w-full preset-filled-primary-400-600 px-6 py-3.5 text-center font-semibold focus-visible:ring-2 focus-visible:ring-primary-700 focus-visible:ring-offset-2 focus-visible:outline-none"
                    >
                        Purchase Plan
                    </a>
                </article>
            </div>
        </div>
    </section>

    <!-- ─────────────────────────────────────────────
        HOW BOOKING WORKS
    ───────────────────────────────────────────── -->
    <section id="how-it-works" class="bg-primary-100-900/70 py-20 md:py-28">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
            <div class="mb-14 reveal text-center">
                <h2 class="mb-4 sect-heading">How Booking Works</h2>
                <p class="sect-subheading">
                    Getting help is simple. Here's what to expect from start to finish.
                </p>
            </div>

            <div class="grid place-content-center gap-5 sm:grid-cols-3">
                {
                    bookingSteps.map((step, i) => (
                        <div
                            class:list={[
                                "group reveal card preset-filled-tertiary-100-900 bg-surface-50-950 p-7 px-5 py-4 shadow-sm shadow-tertiary-200-800/80 backdrop-blur-sm transition-all duration-300 hover:shadow-secondary-200-800",
                                `delay-${(i + 1) * 100}`,
                            ]}
                        >
                            <div class="mb-5 flex size-12 items-center justify-center rounded-full preset-filled-tertiary-700-300 text-center">
                                <span class="text-lg font-bold text-white">{step.number}</span>
                            </div>
                            <div class="mb-5 flex items-center gap-4">
                                <step.icon class="size-5 text-primary-800-200" />
                                <h3 class="text-base font-bold text-surface-950-50">{step.title}</h3>
                            </div>
                            <p class="text-sm leading-relaxed text-surface-700-300">{step.desc}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ─────────────────────────────────────────────
        REMOTE vs IN-HOME + SERVICE AREA
    ───────────────────────────────────────────── -->
    <section class="bg-primary-200-800/70 py-20 md:py-28">
        <div class="sect-content">
            <div class="mb-14 reveal text-center">
                <h2 class="mb-4 sect-heading">Remote or In-Home?</h2>
                <p class="sect-subheading">
                    We'll help you decide which option makes the most sense for your situation.
                </p>
            </div>

            <div class="mb-12 grid gap-6 md:grid-cols-2">
                <article
                    class="reveal card border border-surface-200/70 preset-filled-primary-200-800 p-7 shadow-sm transition-all delay-100 duration-300 hover:-translate-y-1 hover:bg-primary-100-900/60"
                >
                    <div class="mb-5 flex items-center gap-3">
                        <div
                            class="flex h-12 w-12 items-center justify-center rounded-xl border border-surface-300-700 preset-filled-primary-100-900"
                        >
                            <MonitorIcon class="size-6" />
                        </div>
                        <h3 class="text-xl font-bold text-surface-950-50">Remote &amp; Phone</h3>
                    </div>
                    <p class="mb-5 text-sm leading-relaxed text-surface-700-300">
                        Remote support is a great fit for software questions and everyday guidance —
                        no travel required.
                    </p>
                    <ul class="space-y-2.5">
                        {
                            [
                                "Software issues & settings",
                                "Email and account help",
                                "Video call guidance",
                                "Learning to use apps or websites",
                                "Security reviews & password help",
                            ].map((item) => (
                                <li class="flex items-center gap-2 text-sm text-surface-700-300">
                                    <CircleCheck class="size-4 shrink-0 text-primary-500" />
                                    <span>{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                </article>

                <article
                    class="reveal card border border-surface-200/70 preset-filled-primary-200-800 p-7 shadow-sm transition-all delay-100 duration-300 hover:-translate-y-1 hover:bg-primary-100-900/60"
                >
                    <div class="mb-5 flex items-center gap-3">
                        <div
                            class="flex h-12 w-12 items-center justify-center rounded-xl border border-surface-300-700 preset-filled-primary-100-900"
                        >
                            <HouseIcon class="size-6" />
                        </div>
                        <h3 class="text-xl font-bold text-surface-950-50">In-Home Visit</h3>
                    </div>
                    <p class="mb-5 text-sm leading-relaxed text-surface-700-300">
                        Some things are just easier in person. In-home visits are ideal when hands-on
                        help makes a real difference.
                    </p>
                    <ul class="space-y-2.5">
                        {
                            [
                                "Printer setup & troubleshooting",
                                "Wi-Fi & router issues",
                                "Smart home device installation",
                                "Accessibility setup (larger text, voice, etc.)",
                                "Hands-on learning at your own pace",
                            ].map((item) => (
                                <li class="flex items-center gap-2 text-sm text-surface-700-300">
                                    <CircleCheck class="size-4 shrink-0 text-primary-500" />
                                    <span>{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                </article>
            </div>

            <div
                class="reveal card border border-surface-200/70 preset-filled-primary-100-900 p-7 text-secondary-contrast-100-900/30 shadow-lg md:flex-row md:items-center"
            >
                <div class="flex flex-col items-start gap-5 md:flex-row md:items-center">
