---
import MarketingLayout from "@layouts/MarketingLayout.astro";
import {
    LaptopIcon,
    SmartphoneIcon,
    ShieldCheckIcon,
    FolderOpenIcon,
    HeartHandshakeIcon,
    MapPinIcon,
    CircleCheck,
    PhoneIcon,
    HouseIcon,
    StarIcon,
    MailIcon,
    CalendarCheckIcon,
    ChevronRightIcon,
    LockIcon,
    UserCheckIcon,
    CircleQuestionMarkIcon,
    RefreshCwIcon,
    MonitorIcon,
    ArrowRightIcon,
} from "@lucide/astro";

import { PUBLIC_SITE_PHONE, PUBLIC_CONTACT_EMAIL } from "astro:env/client";

const formattedPhone = PUBLIC_SITE_PHONE.replace(
    /(?:\+1)?(?<areaCode>\d{3})(?<part1>\d{3})(?<part2>\d{4})/g,
    (_, areaCode: string, part1: string, part2: string) => `(${areaCode}) ${part1}-${part2}`
);

const bookingUrl = import.meta.env.PUBLIC_BOOK_PAIR_PROGRAMMING || "#contact";

const services = [
    {
        id: "tech-help",
        icon: LaptopIcon,
        accentClass: "bg-brand-700",
        title: "Friendly Tech Help Session",
        remote: "$79",
        inHome: "$129",
        description:
            "Get help with a specific tech problem, an everyday question, or just build your confidence with technology — at your own pace.",
        examples: [
            "Slow computer, phone, or tablet",
            "Email problems",
            "Printer & Wi-Fi issues",
            "Video calls with family, doctors, or appointments",
            "Help using an app or website",
            "General technology questions",
        ],
        goodFor: "First-time support, troubleshooting, building confidence",
        note: null,
    },
    {
        id: "device-setup",
        icon: SmartphoneIcon,
        accentClass: "bg-brand-500",
        title: "New Device Setup",
        remote: "$99",
        inHome: "$149",
        description:
            "Just got a new phone, tablet, computer, or smart device? We'll set it up properly so it works the way you need it to.",
        examples: [
            "Basic setup, updates, and account sign-in",
            "Email, contacts, and apps",
            "Transferring contacts, photos, or files where possible",
            "Printer, Wi-Fi, and Bluetooth setup",
            "Larger text, voice controls & accessibility settings",
            "Smart home setup: doorbells, cameras, thermostats",
        ],
        goodFor: "New phones, tablets, computers, printers, smart TVs, and streaming devices",
        note: "You'll need to provide account passwords, unlock codes, and pay any third-party subscription costs.",
    },
    {
        id: "safety",
        icon: ShieldCheckIcon,
        accentClass: "bg-brand-400",
        title: "Online Safety & Scam Protection Review",
        remote: "$119",
        inHome: "$159",
        description:
            "Feel more confident online. We help you recognize scams, secure your accounts, and protect what matters most to you.",
        examples: [
            "Password and account safety review",
            "Help setting up a password manager",
            "Two-factor authentication setup",
            "Recognizing scam emails, calls & fake websites",
            "Social media privacy settings",
            "Safer online shopping and banking habits",
        ],
        goodFor: "Anyone worried about scams, suspicious emails, or online security",
        note: "This service helps reduce risk but cannot guarantee complete protection from all scams, fraud, or malware.",
    },
    {
        id: "backup",
        icon: FolderOpenIcon,
        accentClass: "bg-caramel-400",
        title: "Photo, File & Backup Organization",
        remote: "$119",
        inHome: "$159",
        description:
            "Protect your memories and important documents. We'll organize your files and set up backups so you don't lose what matters.",
        examples: [
            "Reviewing and setting up cloud or external-drive backups",
            "Organizing photos, videos, and documents",
            "Email cleanup and file-saving guidance",
            "Scanning old photos where equipment and time allow",
            "Creating simple folders and albums easy to find",
        ],
        goodFor: "Anyone whose photos and files are scattered or unprotected",
        note: "Backup services reduce the chance of data loss but cannot guarantee every file can be recovered, transferred, or preserved.",
    },
];

const bookingSteps = [
    {
        number: "1",
        icon: PhoneIcon,
        title: "Tell Us What You Need",
        desc: "Call, email, or fill out our contact form. Describe your problem in plain language — no technical terms needed.",
    },
    {
        number: "2",
        icon: HeartHandshakeIcon,
        title: "We Recommend the Best Option",
        desc: "We'll suggest the right service and advise whether remote or in-home support makes more sense for your situation.",
    },
    {
        number: "3",
        icon: CalendarCheckIcon,
        title: "Choose a Time That Works",
        desc: "Pick an appointment time that's convenient for you. We'll work around your schedule.",
    },
    {
        number: "4",
        icon: UserCheckIcon,
        title: "We Explain Everything First",
        desc: "Before making any changes, we explain what we're going to do and ask for your approval. You stay in control.",
    },
    {
        number: "5",
        icon: CircleCheck,
        title: "Simple Next Steps After",
        desc: "After your session you'll receive clear, plain-language next steps you can keep and refer back to.",
    },
];

const revealDelays = [
    "reveal-delay-1",
    "reveal-delay-2",
    "reveal-delay-3",
    "reveal-delay-4",
    "reveal-delay-5",
];

const decisionItems = [
    { quote: "My computer is slow.", service: "Friendly Tech Help Session", anchor: "#tech-help" },
    {
        quote: "I bought a new phone, tablet, or computer.",
        service: "New Device Setup",
        anchor: "#device-setup",
    },
    {
        quote: "I'm worried about scams or passwords.",
        service: "Online Safety & Scam Protection Review",
        anchor: "#safety",
    },
    {
        quote: "My photos and files are everywhere.",
        service: "Photo, File & Backup Organization",
        anchor: "#backup",
    },
    { quote: "I want ongoing help.", service: "Ongoing Support Plan", anchor: "#plans" },
];
---

<MarketingLayout title="Friendly Tech Help for Older Adults in Montreal">
    <!-- Skip nav for accessibility -->
    <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-brand-700 focus:px-4 focus:py-2 focus:text-white"
    >
        Skip to main content
    </a>

    <main id="main-content">
        <!-- ─────────────────────────────────────────────
             HERO
        ───────────────────────────────────────────── -->
        <section
            class="relative flex min-h-screen items-center overflow-hidden bg-brand-950 pt-16 md:pt-20"
        >
            <!-- Ambient glows -->
            <div
                class="h-md pointer-events-none absolute top-1/3 left-1/4 w-md rounded-full bg-brand-700 opacity-20 blur-3xl"
            >
            </div>
            <div
                class="pointer-events-none absolute right-1/5 bottom-1/4 h-64 w-64 rounded-full bg-caramel-400 opacity-10 blur-3xl"
            >
            </div>

            <!-- Decorative rings -->
            <div
                class="pointer-events-none absolute top-24 right-8 h-56 w-56 rounded-full border border-brand-700 opacity-25 md:right-20"
            >
            </div>
            <div
                class="pointer-events-none absolute top-40 right-20 h-32 w-32 rounded-full border border-brand-600 opacity-20 md:right-36"
            >
            </div>

            <div class="relative mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
                <div class="max-w-3xl">
                    <!-- Location badge -->
                    <div
                        class="mb-8 inline-flex reveal items-center gap-2 rounded-full bg-brand-800 px-4 py-1.5 text-sm font-medium text-caramel-300"
                    >
                        <MapPinIcon class="size-4 shrink-0" />
                        <span>Serving Montreal &amp; Nearby Areas</span>
                    </div>

                    <!-- Headline -->
                    <h1
                        class="reveal-delay-1 mb-6 reveal font-serif text-[clamp(2.25rem,5.5vw,4rem)] leading-[1.12] font-bold text-white"
                    >
                        Friendly Tech Help<br />
                        <span class="text-caramel-300">for Older Adults</span><br />
                        in Montreal
                    </h1>

                    <!-- Subheadline -->
                    <p
                        class="reveal-delay-2 mb-10 max-w-xl reveal text-xl leading-relaxed text-brand-200 md:text-2xl"
                    >
                        Patient, plain-English support at home, by phone, or online. No jargon. No
                        rushing. Just friendly help.
                    </p>

                    <!-- CTA buttons -->
                    <div class="reveal-delay-3 mb-14 flex reveal flex-col gap-4 sm:mb-16 sm:flex-row">
                        <a
                            href={bookingUrl}
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-caramel-400 px-7 py-4 text-lg font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-caramel-500 hover:shadow-lg focus-visible:ring-2 focus-visible:ring-caramel-300 focus-visible:ring-offset-2 focus-visible:ring-offset-brand-950 focus-visible:outline-none"
                        >
                            <CalendarCheckIcon class="size-5" />
                            Book a Tech Help Session
                        </a>
                        <a
                            href="#decision-helper"
                            class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-brand-500 px-7 py-4 text-lg font-medium text-brand-100 transition-all hover:border-brand-400 hover:bg-brand-800 focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-brand-950 focus-visible:outline-none"
                        >
                            Ask What Service Is Right for Me
                        </a>
                    </div>

                    <!-- Trust badges -->
                    <div
                        class="reveal-delay-4 flex reveal flex-wrap gap-x-6 gap-y-3 text-sm text-brand-300"
                    >
                        <div class="flex items-center gap-2">
                            <HouseIcon class="size-4 shrink-0 text-caramel-300" />
                            <span>In-Home Visits</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <PhoneIcon class="size-4 shrink-0 text-caramel-300" />
                            <span>Phone Support</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <MonitorIcon class="size-4 shrink-0 text-caramel-300" />
                            <span>Remote Support</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <ShieldCheckIcon class="size-4 shrink-0 text-caramel-300" />
                            <span>Private &amp; Trustworthy</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             WHY CHOOSE US
        ───────────────────────────────────────────── -->
        <section class="bg-white py-20 md:py-28">
            <div class="mx-auto max-w-6xl px-5 md:px-8">
                <div class="mb-14 reveal text-center">
                    <h2
                        class="mb-4 font-serif text-[clamp(1.875rem,3.5vw,2.75rem)] font-bold text-brand-900"
                    >
                        Tech help that feels different
                    </h2>
                    <p class="mx-auto max-w-2xl text-lg text-brand-600">
                        Technology should make life easier, not more stressful. That's why we do
                        things a little differently.
                    </p>
                </div>

                <div class="grid gap-8 md:grid-cols-3">
                    <div
                        class="reveal-delay-1 reveal rounded-2xl bg-brand-50 p-8 text-center transition-colors hover:bg-brand-100"
                    >
                        <div
                            class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-100 text-brand-700"
                        >
                            <HeartHandshakeIcon class="size-8" />
                        </div>
                        <h3 class="mb-3 text-xl font-bold text-brand-900">
                            Patient &amp; Non-Judgmental
                        </h3>
                        <p class="leading-relaxed text-brand-600">
                            No rushing. No confusing jargon. We explain everything clearly and kindly,
                            at whatever pace feels comfortable for you.
                        </p>
                    </div>

                    <div
                        class="reveal-delay-2 reveal rounded-2xl bg-brand-50 p-8 text-center transition-colors hover:bg-brand-100"
                    >
                        <div
                            class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-100 text-brand-700"
                        >
                            <MapPinIcon class="size-8" />
                        </div>
                        <h3 class="mb-3 text-xl font-bold text-brand-900">Local to Montreal</h3>
                        <p class="leading-relaxed text-brand-600">
                            We come to your home in Montreal and nearby areas, or help you over the
                            phone or online — whichever feels most comfortable for you.
                        </p>
                    </div>

                    <div
                        class="reveal-delay-3 reveal rounded-2xl bg-brand-50 p-8 text-center transition-colors hover:bg-brand-100"
                    >
                        <div
                            class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-100 text-brand-700"
                        >
                            <ShieldCheckIcon class="size-8" />
                        </div>
                        <h3 class="mb-3 text-xl font-bold text-brand-900">You Stay in Control</h3>
                        <p class="leading-relaxed text-brand-600">
                            We explain every change before we make it. Your privacy and comfort
                            matter. Nothing happens without your approval.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             SERVICES
        ───────────────────────────────────────────── -->
        <section id="services" class="bg-brand-50 py-20 md:py-28">
            <div class="mx-auto max-w-6xl px-5 md:px-8">
                <div class="mb-14 reveal text-center">
                    <h2
                        class="mb-4 font-serif text-[clamp(1.875rem,3.5vw,2.75rem)] font-bold text-brand-900"
                    >
                        Our Services
                    </h2>
                    <p class="mx-auto max-w-2xl text-lg text-brand-600">
                        Choose the service that fits your needs, or <a
                            href="#decision-helper"
                            class="text-brand-700 underline underline-offset-2 hover:text-brand-900"
                            >ask us to help you decide</a
                        >.
                    </p>
                </div>

                <div class="grid gap-7 md:grid-cols-2">
                    {
                        services.map((s, i) => (
                            <div
                                id={s.id}
                                class={`reveal ${revealDelays[i] ?? ""} overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm transition-shadow hover:shadow-md`}
                            >
                                <div class={`h-1.5 ${s.accentClass}`} />
                                <div class="p-7 md:p-8">
                                    <div class="mb-5 flex items-start gap-4">
                                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
                                            <s.icon class="size-6" />
                                        </div>
                                        <div>
                                            <h3 class="text-lg leading-snug font-bold text-brand-900 md:text-xl">
                                                {s.title}
                                            </h3>
                                            <p class="mt-1 text-sm font-semibold text-caramel-500 md:text-base">
                                                Starting at {s.remote} remote&nbsp;·&nbsp;{s.inHome}{" "}
                                                in-home
                                            </p>
                                        </div>
                                    </div>

                                    <p class="mb-5 leading-relaxed text-brand-600">{s.description}</p>

                                    <p class="mb-3 text-xs font-bold tracking-widest text-brand-700 uppercase">
                                        Examples include:
                                    </p>
                                    <ul class="mb-6 space-y-1.5">
                                        {s.examples.map((ex) => (
                                            <li class="flex items-start gap-2 text-sm text-brand-600">
                                                <CircleCheck class="mt-0.5 size-4 shrink-0 text-brand-500" />
                                                <span>{ex}</span>
                                            </li>
                                        ))}
                                    </ul>

                                    <div class="space-y-3 border-t border-brand-100 pt-5">
                                        {s.note && (
                                            <p class="text-xs leading-relaxed text-brand-400 italic">
                                                {s.note}
                                            </p>
                                        )}
                                        <a
                                            href={bookingUrl}
                                            class="inline-flex items-center gap-1.5 rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-800 focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-2 focus-visible:outline-none"
                                        >
                                            Book This Service <ChevronRightIcon class="size-4" />
                                        </a>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             ONGOING PLANS
        ───────────────────────────────────────────── -->
        <section id="plans" class="bg-white py-20 md:py-28">
            <div class="mx-auto max-w-5xl px-5 md:px-8">
                <div class="mb-14 reveal text-center">
                    <h2
                        class="mb-4 font-serif text-[clamp(1.875rem,3.5vw,2.75rem)] font-bold text-brand-900"
                    >
                        Ongoing Support Plans
                    </h2>
                    <p class="mx-auto max-w-2xl text-lg text-brand-600">
                        For those who want a familiar person to call before small problems become
                        frustrating.
                    </p>
                </div>

                <div class="grid gap-8 md:grid-cols-2">
                    <!-- Technology Confidence Plan -->
                    <div
                        class="reveal-delay-1 relative reveal overflow-hidden rounded-2xl bg-brand-950 p-8 text-white"
                    >
                        <div
                            class="pointer-events-none absolute top-0 right-0 h-40 w-40 translate-x-10 -translate-y-10 rounded-full bg-caramel-400 opacity-10"
                        >
                        </div>

                        <div class="mb-5 flex items-center gap-3">
                            <div
                                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-caramel-400"
                            >
                                <StarIcon class="size-5 text-white" />
                            </div>
                            <span
                                class="rounded-full bg-caramel-400/20 px-3 py-1 text-xs font-bold tracking-widest text-caramel-300 uppercase"
                                >Most Popular</span
                            >
                        </div>

                        <h3 class="mb-2 text-2xl font-bold">Technology Confidence Plan</h3>
                        <div class="mb-6">
                            <span class="text-4xl font-bold text-caramel-300">$39</span>
                            <span class="text-lg text-brand-300">/month</span>
                            <p class="mt-1 text-sm text-brand-400">or $99 per quarter</p>
                        </div>

                        <ul class="mb-8 space-y-3">
                            {
                                [
                                    "One scheduled remote or phone session each month (up to 30 min)",
                                    "Priority booking when available",
                                    "10% off in-home visits and larger service packages",
                                    "Friendly reminders for updates, backups & online safety",
                                ].map((item) => (
                                    <li class="flex items-start gap-2.5 text-sm leading-relaxed text-brand-200">
                                        <CircleCheck class="mt-0.5 size-5 shrink-0 text-caramel-300" />
                                        <span>{item}</span>
                                    </li>
                                ))
                            }
                        </ul>

                        <a
                            href="#contact"
                            class="block w-full rounded-xl bg-caramel-400 px-6 py-3.5 text-center font-semibold text-white transition-colors hover:bg-caramel-500 focus-visible:ring-2 focus-visible:ring-caramel-300 focus-visible:ring-offset-2 focus-visible:ring-offset-brand-950 focus-visible:outline-none"
                        >
                            Get Started
                        </a>
                    </div>

                    <!-- Backup & Safety Check Plan -->
                    <div
                        class="reveal-delay-2 relative reveal rounded-2xl border-2 border-brand-200 bg-brand-50 p-8"
                    >
                        <div class="mb-5 flex items-center gap-3">
                            <div
                                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-700"
                            >
                                <RefreshCwIcon class="size-5" />
                            </div>
                        </div>

                        <h3 class="mb-2 text-2xl font-bold text-brand-900">
                            Backup &amp; Safety Check Plan
                        </h3>
                        <div class="mb-6">
                            <span class="text-4xl font-bold text-brand-900">$19</span>
                            <span class="text-lg text-brand-500">/month</span>
                            <p class="mt-1 text-sm text-brand-500">
                                + any third-party software or storage costs
                            </p>
                        </div>

                        <ul class="mb-6 space-y-3">
                            {
                                [
                                    "Periodic help checking your backups",
                                    "Password manager health checks",
                                    "Device update checks",
                                    "Basic security settings review",
                                ].map((item) => (
                                    <li class="flex items-start gap-2.5 text-sm leading-relaxed text-brand-600">
                                        <CircleCheck class="mt-0.5 size-5 shrink-0 text-brand-500" />
                                        <span>{item}</span>
                                    </li>
                                ))
                            }
                        </ul>

                        <p class="mb-7 text-xs leading-relaxed text-brand-400 italic">
                            This plan is not continuous security monitoring and does not replace
                            professional cybersecurity services.
                        </p>

                        <a
                            href="#contact"
                            class="block w-full rounded-xl bg-brand-700 px-6 py-3.5 text-center font-semibold text-white transition-colors hover:bg-brand-800 focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-2 focus-visible:outline-none"
                        >
                            Get Started
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             HOW BOOKING WORKS
        ───────────────────────────────────────────── -->
        <section id="how-it-works" class="bg-brand-100 py-20 md:py-28">
            <div class="mx-auto max-w-6xl px-5 md:px-8">
                <div class="mb-16 reveal text-center">
                    <h2
                        class="mb-4 font-serif text-[clamp(1.875rem,3.5vw,2.75rem)] font-bold text-brand-900"
                    >
                        How Booking Works
                    </h2>
                    <p class="mx-auto max-w-2xl text-lg text-brand-600">
                        Getting help is simple. Here's what to expect from start to finish.
                    </p>
                </div>

                <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
                    {
                        bookingSteps.map((step, i) => (
                            <div class={`reveal ${revealDelays[i] ?? ""}`}>
                                <div class="flex items-start gap-5 lg:flex-col lg:items-center lg:text-center">
                                    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand-700 text-xl font-bold text-white shadow-sm">
                                        {step.number}
                                    </div>
                                    <div>
                                        <div class="mb-2 lg:mb-3 lg:flex lg:justify-center">
                                            <step.icon class="size-5 text-brand-600" />
                                        </div>
                                        <h3 class="mb-1.5 text-base font-bold text-brand-900">
                                            {step.title}
                                        </h3>
                                        <p class="text-sm leading-relaxed text-brand-600">
                                            {step.desc}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- ─────────────────────────────────────────────
             REMOTE vs IN-HOME + SERVICE AREA
        ───────────────────────────────────────────── -->
        <section class="bg-white py-20 md:py-28">
            <div class="mx-auto max-w-6xl px-5 md:px-8">
                <div class="mb-14 reveal text-center">
                    <h2
                        class="mb-4 font-serif text-[clamp(1.875rem,3.5vw,2.75rem)] font-bold text-brand-900"
                    >
                        Remote or In-Home?
                    </h2>
                    <p class="mx-auto max-w-2xl text-lg text-brand-600">
                        We'll help you figure out which works best for your situation. Many issues can
                        be resolved quickly from the comfort of your home — without anyone needing to
                        visit.
                    </p>
                </div>

                <div class="mb-14 grid gap-8 md:grid-cols-2">
                    <!-- Remote -->
                    <div
                        class="reveal-delay-1 reveal rounded-2xl border border-brand-100 bg-brand-50 p-8"
                    >
                        <div class="mb-6 flex items-center gap-3">
                            <div
                                class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-700"
                            >
                                <MonitorIcon class="size-6" />
                            </div>
                            <h3 class="text-xl font-bold text-brand-900">Remote &amp; Phone</h3>
                        </div>
                        <p class="mb-5 text-sm leading-relaxed text-brand-600">
                            Remote support is a great fit for software questions and everyday guidance
                            — no travel required.
                        </p>
                        <ul class="space-y-2">
                            {
                                [
                                    "Software issues & settings",
                                    "Email and account help",
                                    "Video call guidance",
                                    "Learning to use apps or websites",
                                    "Security reviews & password help",
                                ].map((item) => (
                                    <li class="flex items-center gap-2 text-sm text-brand-700">
                                        <CircleCheck class="size-4 shrink-0 text-brand-500" />
                                        <span>{item}</span>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <!-- In-Home -->
                    <div
