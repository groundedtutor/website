---
import { CalendarCheckIcon } from "@lucide/astro";
import ThemeToggle from "@components/ThemeToggle.astro";

export interface Props {
    bookingUrl?: string;
}

const { bookingUrl = import.meta.env.PUBLIC_BOOK_PAIR_PROGRAMMING } = Astro.props;
---

<!-- ─────────────────────────────────────────────
     NAVIGATION
───────────────────────────────────────────── -->
<style>
    @reference "../styles/global.css";
    /* ── Sticky nav state ── */
    #site-nav.nav-scrolled {
        @apply border-b border-surface-700-300/30 bg-surface-950-50/92 text-surface-50-950 shadow shadow-surface-950/25 backdrop-blur;
    }

    #site-nav.nav-hidden {
        @apply -translate-y-full;
    }
</style>

<header
    id="site-nav"
    class="group/site-nav fixed top-0 right-0 left-0 z-40 transition-[background-color,box-shadow,transform,translate] duration-300 ease-in-out"
>
    <div class="mx-auto max-w-7xl px-5 md:px-8">
        <nav class="flex h-16 items-center justify-between md:h-20" aria-label="Main navigation">
            <!-- Logo -->
            <a href="/" class="shrink-0" aria-label="GroundedTutor — Home">
                <span class="text-lg font-bold tracking-tight md:text-xl">
                    <span
                        class="text-primary-700-300 group-[.nav-scrolled]/site-nav:text-primary-300-700"
                        >Grounded</span
                    ><span
                        class="text-surface-950-50 group-[.nav-scrolled]/site-nav:text-surface-50-950"
                        >Tutor</span
                    >
                </span>
            </a>

            <!-- Desktop links -->
            <ul
                class="hidden items-center gap-7 text-sm font-medium text-surface-700-300 group-[.nav-scrolled]/site-nav:text-surface-300-700 md:flex"
                role="list"
            >
                <li>
                    <a href="/#services" class="transition-colors hover:text-primary-300-700"
                        >Services</a
                    >
                </li>
                <li>
                    <a href="/#plans" class="transition-colors hover:text-primary-300-700">Plans</a>
                </li>
                <li>
                    <a href="/#how-it-works" class="transition-colors hover:text-primary-300-700"
                        >How It Works</a
                    >
                </li>
                <li>
                    <a href="/#contact" class="transition-colors hover:text-primary-300-700"
                        >Contact</a
                    >
                </li>
            </ul>

            <!-- Accessibility controls + primary action -->
            <ThemeToggle classNames="hidden md:flex" />

            <a
                href={bookingUrl}
                role="button"
                class="btn hidden preset-filled-primary-500 px-3 py-4 font-semibold btn-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-50-950 focus-visible:outline-none md:inline-flex"
            >
                <CalendarCheckIcon class="size-4" />
                Book a Session
            </a>

            <!-- Mobile controls -->
            <div class="flex items-center gap-2 md:hidden">
                <ThemeToggle classNames="md:hidden" />

                <button
                    id="mobile-menu-btn"
                    class="btn-icon preset-tonal-surface text-surface-700-300 btn-icon-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-50-950 focus-visible:outline-none"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                    aria-label="Open navigation menu"
                >
                    <span class="mb-1.5 block h-0.5 w-6 bg-current transition-all" id="mbar1"></span>
                    <span class="mb-1.5 block h-0.5 w-6 bg-current transition-all" id="mbar2"></span>
                    <span class="block h-0.5 w-6 bg-current transition-all" id="mbar3"></span>
                </button>
            </div>
        </nav>
    </div>

    <!-- Mobile menu panel -->
    <div
        id="mobile-menu"
        class="hidden border-t border-surface-200-800 bg-surface-50-950 shadow-lg md:hidden"
        role="dialog"
        aria-label="Mobile navigation"
    >
        <div class="mx-auto max-w-7xl space-y-1 px-5 py-5">
            <a
                href="/#services"
                class="btn block w-full justify-start preset-tonal-surface font-medium text-surface-800-200 btn-base"
                >Services</a
            >
            <a
                href="/#plans"
                class="btn block w-full justify-start preset-tonal-surface font-medium text-surface-800-200 btn-base"
                >Plans</a
            >
            <a
                href="/#how-it-works"
                class="btn block w-full justify-start preset-tonal-surface font-medium text-surface-800-200 btn-base"
                >How It Works</a
            >
            <a
                href="/#contact"
                class="btn block w-full justify-start preset-tonal-surface font-medium text-surface-800-200 btn-base"
                >Contact</a
            >
            <div class="pt-3 pb-1">
                <a
                    href={bookingUrl}
                    class="btn block w-full preset-filled-primary-500 font-semibold btn-base focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-50-950 focus-visible:outline-none"
                    >Book a Session</a
                >
            </div>
        </div>
    </div>
</header>

<script>
    const nav = document.getElementById("site-nav");
    let lastY = window.scrollY;

    function updateNav() {
        const y = window.scrollY;
        if (y > 60) {
            nav?.classList.add("nav-scrolled");
        } else {
            nav?.classList.remove("nav-scrolled");
        }
        if (y > lastY && y > 120) {
            nav?.classList.add("nav-hidden");
        } else {
            nav?.classList.remove("nav-hidden");
        }
        lastY = y;
    }

    window.addEventListener("scroll", updateNav, { passive: true });
    updateNav();

    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");

    btn?.addEventListener("click", () => {
        const isOpen = !menu?.classList.contains("hidden");
        menu?.classList.toggle("hidden", isOpen);
        btn.setAttribute("aria-expanded", (!isOpen).toString());
    });

    menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            menu.classList.add("hidden");
            btn?.setAttribute("aria-expanded", "false");
        });
    });
</script>
