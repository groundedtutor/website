---
import { ChevronUpIcon } from "@lucide/astro";

const buttonId = "scroll-to-top";
---

<a
    id={buttonId}
    href="#top"
    class="fixed right-5 bottom-5 z-50 inline-flex h-12 w-12 items-center gap-2 rounded-full border border-brown-200 bg-brown-50/95 p-2 text-sm font-semibold text-brown-800 shadow-lg shadow-brown-950/10 backdrop-blur duration-500 hover:-translate-y-0.5 hover:bg-white focus-visible:ring-2 focus-visible:ring-brown-700 focus-visible:ring-offset-2 focus-visible:outline-none motion-safe:transition-all"
    aria-label="Scroll to top"
    tabindex={-1}
>
    <ChevronUpIcon aria-hidden="true" class="mx-auto" />
    <span class="pointer-events-none hidden translate-y-48"> </span>

    <script>
        const scrollToTop = document.getElementById("scroll-to-top");
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        function syncVisibility() {
            const isVisible = window.scrollY > 480;
            if (isVisible) {
                scrollToTop?.classList.remove("translate-y-48", "pointer-events-none");
            } else {
                scrollToTop?.classList.add("translate-y-48", "pointer-events-none");
            }
        }

        scrollToTop?.addEventListener("click", (event) => {
            event.preventDefault();
            window.scrollTo({
                top: 0,
                behavior: prefersReducedMotion.matches ? "auto" : "smooth",
            });
        });

        window.addEventListener("scroll", syncVisibility, { passive: true });
        syncVisibility();
    </script>
</a>
