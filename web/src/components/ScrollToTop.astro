---
import { ChevronUpIcon } from "@lucide/astro";

const buttonId = "scroll-to-top";
const visiblityClasses = ["translate-y-48", "pointer-events-none"];
---

<a
    id={buttonId}
    href="#top"
    class="fixed right-5 bottom-5 z-50 inline-flex h-12 w-12 items-center gap-2 rounded-full border border-brand-200 bg-brand-50/95 p-2 text-sm font-semibold text-brand-800 shadow-lg shadow-brand-950/10 backdrop-blur duration-500 hover:-translate-y-0.5 hover:bg-brand-100 focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:outline-none motion-safe:transition-all"
    aria-label="Scroll to top"
    tabindex={-1}
>
    <ChevronUpIcon aria-hidden="true" class="mx-auto" />

    <script is:inline define:vars={{ visiblityClasses }}>
        const scrollToTop = document.getElementById("scroll-to-top");
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        function syncVisibility() {
            const isVisible = window.scrollY > 480;
            if (isVisible) {
                scrollToTop?.classList.remove(...visiblityClasses);
            } else {
                scrollToTop?.classList.add(...visiblityClasses);
            }
        }

        scrollToTop?.addEventListener("click", (event) => {
            event.preventDefault(); // Prevent the default anchor behavior
            window.scrollTo({
                top: 0,
                behavior: prefersReducedMotion.matches ? "auto" : "smooth",
            });
        });

        window.addEventListener("scroll", syncVisibility, { passive: true });
        syncVisibility();
    </script>
</a>
